---
import AccountShell from '../../../layouts/AccountShell.astro';
import Icon from '../../../components/Icon.astro';
import ListingStateActions from '../../../components/ListingStateActions.astro';
import app,{type Listing,displayLabel} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
import {money} from '../../../lib/rooms';
import '../../../styles/listings.css';
const r=await app.fetch(new Request(new URL('/api/account/listings',Astro.url),{headers:{cookie:Astro.request.headers.get('cookie')??''}}),env);if(r.status===401)return Astro.redirect('/dang-nhap');const data=r.ok?await r.json() as {items:Listing[]}:null;if(!data)Astro.response.status=503;
const labels={draft:'Bản nháp',pending:'Chờ xét duyệt',published:'Đang hiển thị',rejected:'Cần bổ sung'},now=Math.floor(Date.now()/1000);
---
<AccountShell title="Tin đăng của tôi" description="Quản lý phòng trọ, bản nháp và kết quả xét duyệt tin đăng."><main id="main-content" class="account-main"><header class="profile-heading"><div><h1>Tin đăng của tôi</h1><p>Quản lý nội dung và theo dõi trạng thái từng phòng.</p></div><a class="button" href="/tai-khoan/tin-dang/moi"><Icon name="plus" size={17}/>Đăng tin mới</a></header>{Astro.url.searchParams.has('saved')&&<p class="profile-success" role="status">Đã lưu bản nháp của bạn.</p>}{Astro.url.searchParams.has('submitted')&&<p class="profile-success" role="status">Đã gửi tin xét duyệt. Kết quả sẽ hiển thị tại đây.</p>}{!data?<p class="alert">Chưa tải được tin. Vui lòng tải lại trang.</p>:data.items.length?<div class="owner-listings">{data.items.map(l=>{const d=JSON.parse(l.details),expired=l.expires_at!=null&&l.expires_at<=now,publicVisible=l.display_state==='available'&&!l.moderation_hidden&&l.published_at!=null&&!expired&&(l.status==='published'||d.keep_public_copy===true);return <article class="profile-card owner-listing"><div class="owner-listing-photo">{d.photos?.[0]?<img src={'/api/listing-images/'+d.photos[0]} alt={l.title} width="160" height="120"/>:<Icon name="home" size={30}/>}</div><div class="owner-listing-copy"><span class={'profile-status '+l.status}>{l.moderation_hidden||l.display_state!=='available'||expired?displayLabel(l):l.published_at!=null&&l.status==='pending'?'Bản sửa chờ xét duyệt':labels[l.status]}</span><h2>{l.title}</h2><p class="owner-listing-price">{money(l.price_vnd)}/tháng · {l.area_m2} m²</p>{publicVisible&&l.status!=='published'&&<p class="help">Bản đã duyệt vẫn đang hiển thị; bản sửa chưa được công khai.</p>}{l.review_note&&<p class="help preserve">{l.review_note}</p>}{l.expires_at&&<p class="help">Hết hạn {new Date(l.expires_at*1000).toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})}</p>}<div class="owner-listing-actions"><a class="text-link" href={'/tai-khoan/tin-dang/'+l.id}>Xem / chỉnh sửa →</a>{publicVisible&&<a class="text-link" href={'/phong/'+l.id}>Mở tin công khai →</a>}{l.status!=='pending'&&<button type="button" class="text-button danger" data-delete-listing={l.id} data-version={l.version}>Xóa tin</button>}</div><ListingStateActions item={l}/></div></article>})}</div>:<section class="profile-card empty-state"><Icon name="home" size={32}/><h2>Bắt đầu với phòng đầu tiên</h2><p>Thêm thông tin và ảnh phòng. Bạn có thể lưu nháp để hoàn thiện sau.</p><a href="/tai-khoan/tin-dang/moi" class="button">Soạn tin đầu tiên</a></section>}<dialog id="delete-listing-dialog" class="listing-delete-dialog"><h2>Xóa tin đăng?</h2><p>Tin sẽ ngừng hiển thị và được gỡ khỏi danh sách của bạn. Xóa tin không cộng lại số dư hoặc lượt miễn phí đã sử dụng.</p><p class="alert" data-delete-error hidden role="alert"></p><div><button type="button" class="button secondary" data-cancel-delete>Giữ lại</button><button type="button" class="button" data-confirm-delete>Xóa tin</button></div></dialog></main><script>import '../../../scripts/listing-list';</script></AccountShell>
