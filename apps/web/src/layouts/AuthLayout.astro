---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import RoomImage from '../components/RoomImage.astro';
import Icon from '../components/Icon.astro';
import '../styles/account.css';
interface Props { title: string; heading: string; intro: string }
const { title,heading,intro } = Astro.props;
---
<Base title={title+' — Trọ Tốt TP.HCM'} description={intro}><SiteHeader/><main id="main-content" class="container auth-page"><section class="auth-visual"><RoomImage photo={0} alt="Góc studio sáng với cửa sổ" eager/><div class="auth-visual-copy"><h2>Chỗ ở mới, nhịp sống mới.</h2><p>Kết nối chủ trọ và người tìm phòng tại TP.HCM, bắt đầu bằng thông tin rõ ràng.</p><a class="text-link" href="/tim-phong">Khám phá phòng<Icon name="arrow" size={17}/></a></div></section><section class="auth-panel"><div class="auth-mobile-banner"><span>Trọ Tốt TP.HCM</span><strong>Chỗ ở mới, nhịp sống mới.</strong></div><h1>{heading}</h1><p class="auth-description">{intro}</p><slot/></section></main><footer class="auth-footer container">Trọ Tốt TP.HCM · Kết nối chỗ ở tại TP.HCM</footer></Base>
