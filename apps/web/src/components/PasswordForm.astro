---
import Icon from './Icon.astro';
---
<form method="post" action="/api/auth/password" data-password-form><div class="field"><label for="current-password">Mật khẩu hiện tại</label><div class="password-field"><input id="current-password" name="current_password" type="password" autocomplete="current-password" required maxlength="128"/><button class="icon-button" type="button" data-toggle-password="current-password" aria-label="Hiện mật khẩu hiện tại"><Icon name="eye" size={18}/></button></div></div><div class="field"><label for="new-password">Mật khẩu mới</label><div class="password-field"><input id="new-password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" aria-describedby="password-guidance"/><button class="icon-button" type="button" data-toggle-password="new-password" aria-label="Hiện mật khẩu mới"><Icon name="eye" size={18}/></button></div><small id="password-guidance">Từ 12–128 ký tự, khác mật khẩu hiện tại.</small></div><div class="field"><label for="confirm-password">Nhập lại mật khẩu mới</label><input id="confirm-password" name="password_confirmation" type="password" autocomplete="new-password" required minlength="12" maxlength="128"/></div><p class="alert" role="alert" data-password-error hidden></p><button type="submit" class="button">Cập nhật mật khẩu <Icon name="arrow" size={16}/></button><noscript><p class="help">Hãy kiểm tra cài đặt trình duyệt rồi tải lại để đổi mật khẩu.</p></noscript></form>
<script>
import {displayError,readApiJson} from '../scripts/api-errors';
for(const form of document.querySelectorAll<HTMLFormElement>('[data-password-form]'))form.addEventListener('submit',async event=>{event.preventDefault();const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!,error=form.querySelector<HTMLElement>('[data-password-error]')!;button.disabled=true;error.hidden=true;try{const response=await fetch(form.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(form))),signal:AbortSignal.timeout(20000)});const data=await readApiJson<{redirect?:string}>(response,'Chưa đổi được mật khẩu. Kiểm tra thông tin rồi thử lại.');location.assign(data.redirect??'/dang-nhap');}catch(e){error.textContent=displayError(e,'Chưa đổi được mật khẩu. Kiểm tra kết nối rồi thử lại.');error.hidden=false;button.disabled=false;}});
</script>
