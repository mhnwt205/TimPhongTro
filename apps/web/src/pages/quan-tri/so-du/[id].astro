---
import CmsLayout from '../../../layouts/CmsLayout.astro';
import FinanceConfirm from '../../../components/FinanceConfirm.astro';
import WalletLedger from '../../../components/WalletLedger.astro';
import {can,type WalletSummary,type WalletEntry} from '@timphongtro/api';
import {financeRead,money,type Page} from '../../../lib/finance';
type Detail=WalletSummary&{user:{id:string;name:string;email:string;is_locked:number;deleted_at:number|null};ledger:Page<WalletEntry>};
const {data,status}=await financeRead<Detail>('/api/cms/wallets/'+encodeURIComponent(Astro.params.id??'')+'?page='+(Astro.url.searchParams.get('page')??'1'),Astro.url,Astro.request.headers.get('cookie'));
if(status===404)return Astro.rewrite('/404');if(!data)Astro.response.status=status;
const editable=can(Astro.locals.user,'wallets.adjust')&&data?.user.id!==Astro.locals.user!.id;
---
<CmsLayout title="Sổ giao dịch tài khoản" description="Xem số dư và điều chỉnh và lưu đầy đủ lịch sử."><main id="main-content"><a class="finance-back" href="/quan-tri/so-du">← Danh sách số dư</a><div class="cms-heading"><div><h1>Sổ giao dịch</h1><p>{data?.user.name} · {data?.user.email}</p></div></div>
{!data?<p class="alert" role="alert">Không tải được sổ số dư của tài khoản này. Quay lại danh sách hoặc tải lại trang.</p>:<><div class="finance-summary"><section class="finance-balance"><span>Số dư khả dụng</span><strong>{money(data.balance_vnd)}</strong><p>Đang giữ để rút: <b>{money(data.held_vnd)}</b></p><p>{data.user.deleted_at?'Tài khoản đã xóa mềm; lịch sử được giữ.':data.user.is_locked?'Tài khoản đang khóa.':'Tài khoản đang hoạt động.'}</p></section><section class="finance-promotion"><span>Lượt đăng miễn phí còn lại</span><strong>{data.free_posts_remaining} / {data.free_posts_total}</strong><p>Lượt miễn phí tách biệt với tiền nạp; tiêu hao khi xuất bản tin đủ điều kiện.</p></section></div><section class="finance-panel"><h2>Lịch sử cộng / trừ</h2><WalletLedger ledger={data.ledger} pagePath={'/quan-tri/so-du/'+data.user.id}/></section>
{editable&&<section class="finance-panel finance-settings"><h2>Điều chỉnh số dư</h2><p class="help">Dùng để sửa sai số dư có căn cứ. Đây không phải thao tác hoàn/chuyển tiền ngân hàng.</p><form method="post" data-finance-form data-endpoint={'/api/cms/wallets/'+data.user.id+'/adjust'} data-confirm="adjustment" data-beneficiary={data.user.name+' · '+data.user.email}><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="field" style="margin-top:18px"><label for="adjustment-amount">Mức điều chỉnh (VND)</label><input id="adjustment-amount" name="amount_vnd" type="number" inputmode="numeric" min="-1000000" max="1000000" step="1" required data-number/><small>Số dương để cộng, số âm để giảm; tối đa ±1.000.000đ, khác 0.</small></div><div class="field"><label for="adjustment-note">Lý do điều chỉnh</label><textarea id="adjustment-note" name="note" rows="3" required minlength="10" maxlength="1000"/></div><label class="finance-checkbox"><input type="checkbox" name="confirmed" required/><span>Tôi đã kiểm tra căn cứ điều chỉnh và hiểu thao tác sẽ ghi lại thay đổi trong lịch sử giao dịch.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button" type="submit">Kiểm tra điều chỉnh</button></form></section>}
</>}
</main><FinanceConfirm/><script>import '../../../scripts/finance';</script></CmsLayout>
