---
import CmsLayout from '../layouts/CmsLayout.astro';
import Icon from './Icon.astro';
import app,{can,permissionGroups,actionLabels,activityLabel} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
import {cmsSections,dateVi,moneyVi} from '../lib/cms';
interface Props{resource:string}
const section=cmsSections.find(s=>s.slug===Astro.props.resource);
if(!section)return Astro.rewrite('/404');
const key=section.key,user=Astro.locals.user!;
const q=Astro.url.searchParams.get('q')??'',state=Astro.url.searchParams.get('state')??'active',page=Astro.url.searchParams.get('page')??'1';
const headers={cookie:Astro.request.headers.get('cookie')??''};
const response=await app.fetch(new Request(new URL('/api/cms/'+key+'?'+new URLSearchParams({q,state,page}),Astro.url),{headers}),env);
type Row=Record<string,any>;
const data=response.ok?await response.json() as {items:Row[];total:number;page:number;page_size:number}:null;
if(!response.ok)Astro.response.status=response.status;
const optionsResponse=await app.fetch(new Request(new URL('/api/cms/options',Astro.url),{headers}),env);
const options=optionsResponse.ok?await optionsResponse.json() as {roles?:{id:string;name:string}[];locations?:{id:string;name:string}[];owners?:{id:string;name:string}[]}:{};
const permissions={create:can(user,key+'.create'),update:can(user,key+'.update'),delete:can(user,key+'.delete'),assign:can(user,'users.assign_roles')};
const permissionName=(permission:string)=>{const [key,action]=permission.split('.');return (permissionGroups.find(g=>g.key===key)?.label??key)+' · '+(actionLabels[action]??action);};
const titleOf=(row:Row)=>key==='audit'?activityLabel(row.action):row.name??row.title;
const roleName=(id:string)=>options.roles?.find(r=>r.id===id)?.name??id;
const detail=(row:Row)=>key==='users'?row.email:key==='plans'?moneyVi(row.price_vnd)+' · '+row.duration_days+' ngày'+(row.is_priority?' · Ưu tiên hiển thị':''):key==='roles'?row.permissions.length+' quyền':key==='content'?'/thong-tin/'+row.slug:key==='listings'?moneyVi(row.price_vnd)+' /tháng · '+row.area_m2+' m²':key==='audit'?(row.actor_name??'Hệ thống')+' · '+dateVi(row.created_at):row.description;
const rowStatus=(row:Row)=>key==='audit'?row.note||'Đã ghi nhận':row.deleted_at?'Trong thùng rác':row.is_super_admin?'Quản trị cao nhất':key==='users'?(row.is_locked?'Đã khóa':'Đang hoạt động'):key==='listings'?({draft:'Bản nháp',pending:'Chờ duyệt',published:'Đã xuất bản',rejected:'Cần bổ sung'}[String(row.status)]??'Bản nháp'):key==='roles'?'Đang sử dụng':row.is_active?'Đang bật':'Đang tắt';
const nextUrl=(n:number)=>'?'+new URLSearchParams({q,state,page:String(n)});
const fields=key==='users'?[['name','Tên hiển thị','text',100],['email','Email đăng nhập','email',254],['password','Mật khẩu ban đầu','password',128]]:key==='plans'?[['name','Tên gói','text',100],['price_vnd','Giá gói (VND)','number',1000000000],['duration_days','Số ngày hiển thị','number',365],['description','Mô tả gói','textarea',500]]:key==='roles'||key==='locations'?[['name',key==='roles'?'Tên vai trò':'Tên khu vực','text',key==='roles'?80:100],['description','Mô tả','textarea',500]]:key==='content'?[['title','Tiêu đề','text',150],['slug','Đường dẫn (chữ thường, số và dấu gạch ngang)','text',100],['body','Nội dung văn bản','textarea',6000]]:[['title','Tiêu đề phòng','text',150],['price_vnd','Giá thuê mỗi tháng (VND)','number',1000000000],['area_m2','Diện tích (m²)','number',10000],['description','Mô tả phòng','textarea',4000]];
const serial=JSON.stringify({key,items:data?.items??[],permissions,options,actorId:user.id}).replaceAll('<','\\u003c');
---
<CmsLayout title={section.label} description={section.description}>
<main id="main-content"><div class="cms-heading"><div><h1>{section.label}</h1><p>{section.description}</p></div>{permissions.create&&(key==='listings'?<a class="button" href="/quan-tri/tin-phong/tao"><Icon name="plus" size={17}/>Tạo tin phòng</a>:<button type="button" class="button" data-cms-create><Icon name="plus" size={17}/>Tạo mới</button>)}</div>
{key==='listings'&&<p style="margin-bottom:20px"><a class="text-link" href="/quan-tri/tin-phong">← Xét duyệt tin phòng</a></p>}<div class="cms-sheet"><form method="get" class="cms-filters"><label>Tìm kiếm<input name="q" value={q} maxlength="100" placeholder={key==='audit'?'Thao tác hoặc mã đối tượng':'Tên hoặc từ khóa'}/></label>{key!=='audit'&&<label>Danh sách<select name="state"><option value="active" selected={state==='active'}>Đang quản lý</option><option value="deleted" selected={state==='deleted'}>Thùng rác</option><option value="all" selected={state==='all'}>Tất cả</option>{key==='users'&&<option value="locked" selected={state==='locked'}>Đã khóa</option>}</select></label>}<button class="button secondary" type="submit">Tìm / lọc</button></form>
{!data?<p class="alert" role="alert">Không tải được dữ liệu. Kiểm tra bộ lọc và quyền truy cập rồi thử lại.</p>:<>
<p class="help" style="margin-bottom:16px">{data.total} bản ghi · Trang {data.page}</p>
{!data.items.length?<div class="empty-state"><Icon name="list" size={28}/><h2>Chưa có bản ghi phù hợp</h2><p>Tạo bản ghi mới nếu bạn được cấp quyền hoặc thay đổi bộ lọc.</p></div>:<div class="cms-table-wrap"><table class="cms-table"><thead><tr><th>{key==='audit'?'Thao tác':'Tên / tiêu đề'}</th><th>Thông tin</th><th>Trạng thái / thao tác</th></tr></thead><tbody>{data.items.map(row=><tr>
<td data-label={key==='audit'?'Thao tác':'Tên / tiêu đề'}><strong>{titleOf(row)}</strong><small>{key==='audit'?row.target_id:'Mã: '+row.id}</small>{key==='users'&&row.role_ids?.length>0&&<small>Vai trò: {row.role_ids.map(roleName).join(', ')}</small>}</td>
<td data-label="Thông tin">{detail(row)}{['content','roles','listings','plans'].includes(key)&&<details class="cms-record-detail"><summary>Xem chi tiết</summary><dl>{key==='roles'?<div><dt>Quyền đã cấp</dt><dd>{row.permissions.map(permissionName).join(', ')||'Chưa cấp quyền'}</dd></div>:<><div><dt>{key==='content'?'Nội dung':'Mô tả'}</dt><dd>{key==='content'?row.body:row.description||'Chưa có mô tả.'}</dd></div>{key==='listings'&&<><div><dt>Người phụ trách</dt><dd>{options.owners?.find(o=>o.id===row.owner_id)?.name??row.owner_id}</dd></div><div><dt>Khu vực</dt><dd>{options.locations?.find(l=>l.id===row.location_id)?.name??row.location_id}</dd></div></>}</>}</dl></details>}</td>
<td data-label="Trạng thái / thao tác"><div class="cms-record-state"><span class={key==='audit'?'cms-record-note':'cms-badge'}>{rowStatus(row)}</span>{key!=='audit'&&<div class="cms-row-actions">
{!row.deleted_at&&permissions.update&&(key==='listings'?<a href={'/quan-tri/tin-phong/'+row.id+'/sua'}>Sửa chi tiết</a>:<button type="button" data-cms-edit={row.id}>Sửa</button>)}
{key==='content'&&!row.deleted_at&&<a href={'/thong-tin/'+row.slug+(row.is_active===1?'':'?preview=1')} target="_blank" rel="noopener">{row.is_active===1?'Mở trang':'Xem thử'}</a>}
{key==='users'&&!row.deleted_at&&!row.is_super_admin&&row.id!==user.id&&<>
{permissions.assign&&<button type="button" data-cms-roles={row.id}>Phân quyền</button>}
{permissions.update&&<button type="button" data-cms-action={row.is_locked?'unlock':'lock'} data-id={row.id}>{row.is_locked?'Mở khóa':'Khóa'}</button>}</>}
{permissions.delete&&!(key==='users'&&(row.is_super_admin||row.id===user.id))&&<button type="button" class={row.deleted_at?'':'danger-text'} data-cms-action={row.deleted_at?'restore':'delete'} data-id={row.id}>{row.deleted_at?'Khôi phục':'Xóa'}</button>}
</div>}</div></td>
</tr>)}</tbody></table></div>}
<nav class="cms-pagination" aria-label="Phân trang CMS"><span>{data.page>1&&<a href={nextUrl(data.page-1)}>← Trang trước</a>}</span>{data.page*data.page_size<data.total&&<a href={nextUrl(data.page+1)}>Trang sau →</a>}</nav></>}
</div></main>
{!['audit','listings'].includes(key)&&<>
<dialog id="cms-editor" class="cms-dialog"><div class="cms-dialog-header"><h2 data-editor-title>Tạo mới</h2><button type="button" class="icon-button" data-close-dialog aria-label="Đóng biểu mẫu"><Icon name="close"/></button></div><form id="cms-edit-form"><div class="cms-form-grid">
{fields.map(([name,label,type,max])=><div class={'field '+(type==='textarea'?'wide':'')} data-field-wrap={name}><label for={'edit-'+name}>{label}</label>{type==='textarea'?<><textarea id={'edit-'+name} name={String(name)} rows={name==='body'?10:4} maxlength={Number(max)}/>{key==='plans'&&name==='description'&&<small>Mô tả này sẽ hiển thị công khai trên bảng giá. Chỉ ghi quyền lợi và điều kiện đúng của gói.</small>}</>:<input id={'edit-'+name} name={String(name)} type={type as 'text'|'email'|'password'|'number'} required min={name==='area_m2'?0.1:1} step={name==='area_m2'?0.1:1} minlength={name==='password'?12:undefined} maxlength={type==='number'?undefined:Number(max)} max={type==='number'?Number(max):undefined} autocomplete={name==='password'?'new-password':name==='email'?'email':'off'}/>}</div>)}
{key==='roles'&&permissionGroups.map(group=><fieldset><legend>{group.label}</legend><div class="cms-checks">{group.actions.map(action=><label><input type="checkbox" name="permissions" value={group.key+'.'+action} disabled={!can(user,group.key+'.'+action)}/>{actionLabels[action]}</label>)}</div></fieldset>)}
{key==='listings'&&<><div class="field"><label for="edit-owner">Người phụ trách</label><select id="edit-owner" name="owner_id" required>{options.owners?.map(o=><option value={o.id}>{o.name}</option>)}</select></div><div class="field"><label for="edit-location">Khu vực</label><select id="edit-location" name="location_id" required>{options.locations?.map(l=><option value={l.id}>{l.name}</option>)}</select></div><div class="field"><label for="edit-type">Loại phòng</label><select id="edit-type" name="room_type"><option value="room">Phòng trọ</option><option value="studio">Căn hộ mini</option></select></div></>}
{key==='plans'&&<fieldset class="cms-plan-priority"><legend>Hiển thị tin</legend><label><input type="checkbox" name="is_priority" value="1"/><span>Ưu tiên hiển thị</span></label><small>Tin dùng gói này được xếp trước tin thường khi người thuê tìm phòng.</small></fieldset>}
{['plans','locations','content'].includes(key)&&<div class="field wide"><label for="edit-active">Trạng thái</label><select id="edit-active" name="is_active"><option value="0">Đang tắt / ẩn khỏi công khai</option><option value="1">Đang bật / hiển thị công khai</option></select>{key==='plans'&&<small>Chỉ gói đang bật mới xuất hiện trên bảng giá và biểu mẫu đăng tin.</small>}{key==='content'&&<small>Chỉ trang đang bật mới truy cập công khai qua /thong-tin/đường-dẫn. </small>}</div>}
</div><p class="cms-form-error" role="alert" hidden></p><div class="cms-form-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Lưu thay đổi</button></div></form></dialog>
<dialog id="cms-confirm" class="cms-dialog"><div class="cms-dialog-header"><h2 data-confirm-title>Xác nhận thao tác</h2><button class="icon-button" type="button" data-close-dialog aria-label="Đóng xác nhận"><Icon name="close"/></button></div><form id="cms-confirm-form"><p data-confirm-description class="help"></p><div class="field" style="margin-top:20px"><label for="action-note">Lý do thao tác</label><textarea id="action-note" name="note" required minlength="5" maxlength="500" rows="3"/></div><p class="cms-form-error" role="alert" hidden></p><div class="cms-form-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Xác nhận</button></div></form></dialog>
{key==='users'&&permissions.assign&&<dialog id="cms-roles" class="cms-dialog"><div class="cms-dialog-header"><h2>Phân quyền tài khoản</h2><button class="icon-button" type="button" data-close-dialog aria-label="Đóng phân quyền"><Icon name="close"/></button></div><form id="cms-roles-form"><p class="help" data-roles-description></p><div class="cms-checks" style="margin-top:16px">{options.roles?.map(role=><label><input type="checkbox" name="role_ids" value={role.id}/>{role.name}</label>)}</div><p class="help" style="margin-top:16px">Bỏ chọn tất cả để thu hồi quyền CMS. Thao tác kết thúc các phiên đăng nhập hiện tại.</p><p class="cms-form-error" role="alert" hidden></p><div class="cms-form-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Lưu phân quyền</button></div></form></dialog>}
</>}
<script type="application/json" id="cms-data" nonce={Astro.locals.cspNonce} set:html={serial}/>
<script>import '../scripts/cms';</script>
</CmsLayout>
