---
import CmsLayout from '../../layouts/CmsLayout.astro';
import Icon from '../../components/Icon.astro';
import CmsActivityChart from '../../components/CmsActivityChart.astro';
import app,{can,type CmsDashboard} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
import {cmsSections,financeSections,reportSection} from '../../lib/cms';
const user=Astro.locals.user!,days=Astro.url.searchParams.get('days')==='30'?30:7;
const response=await app.fetch(new Request(new URL('/api/cms/summary?days='+days,Astro.url),{headers:{cookie:Astro.request.headers.get('cookie')??''}}),env);
const data=response.ok?await response.json() as CmsDashboard:null;
const metricDefinitions=[{key:'users',label:'Tài khoản',detail:'Tài khoản đang quản lý',icon:'user',href:'/quan-tri/tai-khoan'}, {key:'sellers',label:'Chờ duyệt người đăng',detail:'Hồ sơ cần được kiểm tra',icon:'user-check',href:'/quan-tri/nguoi-dang?status=pending'}, {key:'listings',label:'Tin phòng',detail:'Tin phòng đang quản lý',icon:'home',href:'/quan-tri/tin-phong'}, {key:'content',label:'Trang nội dung',detail:'Hướng dẫn và thông tin',icon:'list',href:'/quan-tri/noi-dung'}];
const seriesOptions=[{key:'users',label:'Tài khoản mới'},{key:'listings',label:'Tin phòng mới'},{key:'content',label:'Nội dung mới'}].filter(s=>data?.activity[0]?.[s.key as 'users'|'listings'|'content']!==undefined);
const metric=(seriesOptions.find(s=>s.key===Astro.url.searchParams.get('metric'))?.key??seriesOptions[0]?.key??'users') as 'users'|'listings'|'content';
const distribution=data?.distribution,total=distribution?.items.reduce((n,i)=>n+i.value,0)??0;
let offset=0;
const segments=distribution?.items.map(item=>{const percent=total?item.value/total*100:0;const result={...item,percent,offset};offset+=percent;return result;})??[];
const date=new Date().toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'});
const time=(stamp:number)=>new Date(stamp*1000).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
const financeShortcuts=financeSections.filter(s=>s.key==='topups'?can(user,'topups.read')||can(user,'payments.read'):can(user,s.key+'.read'));
const links=[...cmsSections,...financeShortcuts,reportSection].filter(s=>can(user,s.key+'.read')||s.key==='topups'&&can(user,'payments.read'));
---
<CmsLayout title="Tổng quan" description="Theo dõi hoạt động và công việc quản trị Trọ Tốt TP.HCM." notifications={data?.notifications}>
 <main id="main-content" class="cms-dashboard">
  <div class="dashboard-heading"><div><p class="dashboard-date">{date} <span>TP.HCM</span></p><h1>Quản trị website</h1><p>Theo dõi hoạt động và xử lý công việc trong ngày.</p></div><form method="get" class="dashboard-period"><label for="dashboard-days">Khoảng thời gian</label><div><Icon name="calendar" size={16}/><select id="dashboard-days" name="days"><option value="7" selected={days===7}>7 ngày gần nhất</option><option value="30" selected={days===30}>30 ngày gần nhất</option></select><input type="hidden" name="metric" value={metric}/><button class="icon-button" type="submit" aria-label="Cập nhật khoảng thời gian"><Icon name="refresh" size={17}/></button></div></form></div>
  {!data?<p class="alert" role="alert">Không tải được dữ liệu tổng quan. Hãy thử tải lại trang.</p>:<>
   <section class="dashboard-metrics" aria-label="Số liệu tổng quan">{metricDefinitions.filter(m=>data.metrics[m.key]!==undefined).map(m=><a class:list={['dashboard-metric',{'needs-attention':m.key==='sellers'&&data.metrics[m.key]>0}]} href={m.href}><div class="dashboard-metric-top"><span>{m.label}</span><Icon name={m.icon} size={21}/></div><strong>{data.metrics[m.key].toLocaleString('vi-VN')}</strong><div class="dashboard-metric-bottom"><span>{m.detail}</span><Icon name="arrow" size={16}/></div></a>)}</section>
   <div class="dashboard-analytics">
    {seriesOptions.length>0?<CmsActivityChart activity={data.activity} metric={metric} days={days} options={seriesOptions}/>:<section class="dashboard-panel dashboard-no-chart"><Icon name="chart" size={30}/><h2>Tổng quan theo quyền của bạn</h2><p>Biểu đồ sẽ hiển thị khi tài khoản được cấp quyền xem tài khoản, tin phòng hoặc nội dung.</p><a href="/quan-tri/bao-mat" class="text-link">Bảo mật tài khoản <Icon name="arrow" size={16}/></a></section>}
    {distribution&&distribution.items.length>0&&<section class="dashboard-panel distribution-panel" aria-labelledby="distribution-title"><header class="dashboard-panel-heading"><div><span class="dashboard-kicker">Tình hình hiện tại</span><h2 id="distribution-title">{distribution.title}</h2></div><Icon name="pie" size={20}/></header><div class="distribution-donut" role="img" aria-label={distribution.title+': '+segments.map(s=>s.label+' '+s.value).join(', ')}><svg viewBox="0 0 128 128" aria-hidden="true"><circle class="donut-track" cx="64" cy="64" r="48"/>{segments.filter(s=>s.value>0).map(s=><circle class={'donut-segment '+s.tone} cx="64" cy="64" r="48" pathLength="100" stroke-dasharray={`${s.percent} ${100-s.percent}`} stroke-dashoffset={-s.offset}/>)}</svg><div><strong>{total.toLocaleString('vi-VN')}</strong><span>{distribution.title==='Trạng thái người đăng'?'người đăng':'bản ghi'}</span></div></div><div class="distribution-legend">{segments.map(s=><a href={s.href}><span><i class={'legend-dot '+s.tone}></i>{s.label}</span><strong>{s.value.toLocaleString('vi-VN')}</strong></a>)}</div><p class="dashboard-panel-footnote">{distribution.title==='Trạng thái người đăng'?'Hồ sơ của tài khoản đang hoạt động.':distribution.title==='Trạng thái tài khoản'?'Không gồm tài khoản trong thùng rác.':'Không gồm nội dung trong thùng rác.'}</p>{!total&&<p class="distribution-empty">Chưa có dữ liệu trong nhóm này.</p>}<a class="distribution-manage" href={distribution.title==='Trạng thái người đăng'?'/quan-tri/nguoi-dang?status=all':distribution.items[0].href}>Mở danh sách quản lý <Icon name="arrow" size={16}/></a></section>}
   </div>
   <div class="dashboard-work-grid">
    {can(user,'sellers.read')&&<section class="dashboard-panel queue-panel"><header class="dashboard-panel-heading"><div><span class="dashboard-kicker">Công việc hôm nay</span><h2>Hồ sơ chờ xét duyệt <b>{data.metrics.sellers}</b></h2></div><a href="/quan-tri/nguoi-dang?status=pending" class="text-link">Xem tất cả <Icon name="arrow" size={15}/></a></header>{data.pending_sellers.length?<div class="dashboard-queue-list">{data.pending_sellers.map(s=><a href="/quan-tri/nguoi-dang?status=pending"><span class="queue-avatar"><Icon name="user" size={19}/></span><div><strong>{s.name}</strong><p>{s.type==='owner'?'Chủ trọ':'Môi giới'} · {time(s.submitted_at)}</p></div><span class="queue-state">Chờ duyệt</span><Icon name="chevron" size={15}/></a>)}</div>:<div class="dashboard-queue-empty"><span><Icon name="check" size={24}/></span><strong>Không có hồ sơ đang chờ</strong><p>Hồ sơ mới sẽ xuất hiện tại đây khi người đăng gửi thông tin.</p></div>}</section>}
    {can(user,'audit.read')&&<section class="dashboard-panel recent-panel"><header class="dashboard-panel-heading"><div><span class="dashboard-kicker">Nhật ký hệ thống</span><h2>Hoạt động gần đây</h2></div><a href="/quan-tri/nhat-ky" class="text-link" aria-label="Mở nhật ký đầy đủ"><Icon name="arrow" size={18}/></a></header>{data.notifications.activity.length?<ol class="dashboard-timeline">{data.notifications.activity.map(a=><li><span class="timeline-dot"></span><div><a href={a.href}>{a.label}</a><p>{a.actor}</p></div><time datetime={new Date(a.created_at*1000).toISOString()}>{time(a.created_at)}</time></li>)}</ol>:<p class="cms-notice-empty">Chưa có hoạt động quản trị.</p>}</section>}
   </div>
  </>}
  {links.length>0&&<section class="dashboard-shortcuts" aria-labelledby="shortcuts-title"><div class="dashboard-section-title"><h2 id="shortcuts-title">Truy cập nhanh</h2><span>Các mục trong quyền quản lý</span></div><div>{links.map(s=><a href={'/quan-tri/'+s.slug}><Icon name={s.icon} size={18}/><span>{s.label}</span><Icon name="chevron" size={14}/></a>)}</div></section>}
  <footer class="dashboard-status"><span><i></i>Hoạt động quản lý hôm nay</span>{data&&<span>Cập nhật {time(data.updated_at)}</span>}</footer>
 </main>
</CmsLayout>
