---
import AccountShell from '../../../../layouts/AccountShell.astro';
import ListingStateActions from '../../../../components/ListingStateActions.astro';
import app,{type Listing,type Renewal,displayLabel} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
import {money,date} from '../../../../lib/finance';
import '../../../../styles/renewals.css';
const response=await app.fetch(new Request(new URL('/api/account/listings/'+encodeURIComponent(Astro.params.id??'')+'/renewals',Astro.url),{headers:{cookie:Astro.request.headers.get('cookie')??''}}),env);
if(response.status===401)return Astro.redirect('/dang-nhap');
const data=response.ok?await response.json() as {item:Listing;plans:{id:string;name:string;price_vnd:number;duration_days:number;is_priority:number}[];balance_vnd:number;requests:Renewal[];events:{action:string;note:string;created_at:number}[]}:null;
if(!data)Astro.response.status=response.status;
const pending=data?.requests.find(r=>r.status==='pending'),labels={pending:'Chờ xét duyệt',approved:'Đã gia hạn',rejected:'Bị từ chối',cancelled:'Đã hủy'};
const events:Record<string,string>={published:'Xuất bản lần đầu',hide:'Tạm ẩn tin',unavailable:'Đánh dấu hết phòng',reopen:'Mở lại tin',confirm:'Xác nhận còn phòng',block:'Tin được ẩn để kiểm tra',unblock:'Tin được hiển thị lại',renewal_requested:'Gửi yêu cầu gia hạn',renewal_approved:'Duyệt gia hạn',renewal_rejected:'Từ chối gia hạn',renewal_cancelled:'Hủy yêu cầu gia hạn'};
---
<AccountShell title="Gia hạn & lịch sử tin" description="Chọn gói gia hạn và theo dõi các kỳ hiển thị đã được duyệt."><main id="main-content" class="account-main renewal-page"><header class="profile-heading"><div><h1>Gia hạn & lịch sử</h1><p>{data?.item.title??'Tin phòng'}</p></div><a class="button secondary" href="/tai-khoan/tin-dang">Tin của tôi</a></header>
{!data?<p class="alert" role="alert">Không tải được thông tin tin cần gia hạn. Mở lại tin từ mục “Tin đăng của tôi” hoặc tải lại trang.</p>:<>
<section class="profile-card"><h2>{displayLabel(data.item)}</h2><dl class="renewal-summary"><div><dt>Hạn hiển thị hiện tại</dt><dd>{date(data.item.expires_at!)}</dd></div><div><dt>Số dư đăng tin</dt><dd>{money(data.balance_vnd)}</dd></div></dl><p class="help">Ẩn tin hoặc đánh dấu hết phòng vẫn tiếp tục chạy thời hạn, không hoàn phí hoặc cộng bù. Duyệt gia hạn chỉ cộng thời hạn; tin đang ẩn/hết phòng vẫn giữ trạng thái đó cho đến khi bạn mở lại.</p><ListingStateActions item={data.item}/></section>
<section class="profile-card"><h2>Yêu cầu gia hạn</h2>{pending?<p class="finance-notice">Tin đã có yêu cầu chờ xét duyệt. Xem yêu cầu bên dưới; bạn có thể hủy trước khi xử lý.</p>:data.item.moderation_hidden?<p class="finance-notice warning">Tin đang được ẩn để quản trị viên kiểm tra. Liên hệ bộ phận hỗ trợ trước khi gia hạn.</p>:!data.plans.length?<p class="help">Chưa có gói đang hoạt động. Vui lòng liên hệ hỗ trợ.</p>:<form data-renewal-create data-id={data.item.id} data-request-key={crypto.randomUUID()} data-current-expiry={data.item.expires_at}>
<div class="field"><label for="renewal-plan">Gói gia hạn</label><select id="renewal-plan" name="plan_id" required><option value="">Chọn gói gia hạn</option>{data.plans.map(plan=><option value={plan.id} data-price={plan.price_vnd} data-days={plan.duration_days}>{plan.name} · {plan.duration_days} ngày · {money(plan.price_vnd)}{plan.is_priority?' · Ưu tiên hiển thị':''}</option>)}</select></div>
<p class="renewal-preview" data-renewal-preview>Chọn gói để xem phí và ngày hết hạn dự kiến.</p>
<p class="help">Còn hạn thì nối từ ngày hết hạn hiện tại; đã hết hạn thì tính từ lúc yêu cầu được duyệt. Gói và mức ưu tiên mới bắt đầu từ đầu kỳ gia hạn. Chỉ dùng số dư, không dùng lượt miễn phí.</p>
<label class="finance-checkbox"><input name="confirmed" type="checkbox" required/><span>Tôi xác nhận gói đã chọn. Phí chỉ được trừ và thời hạn chỉ được cộng sau khi yêu cầu được duyệt; gửi yêu cầu chưa trừ tiền.</span></label><p class="alert" data-renewal-error role="alert" hidden></p><button class="button" type="submit">Gửi yêu cầu gia hạn</button>
</form>}</section>
<section class="profile-card"><h2>Các yêu cầu và kỳ gia hạn</h2>{!data.requests.length?<p class="help">Chưa có yêu cầu gia hạn.</p>:<div class="renewal-history">{data.requests.map(r=><article><div class="renewal-card-heading"><h3>{r.plan_name}</h3><span class="cms-badge">{labels[r.status]}</span></div><p>{r.duration_days} ngày · {money(r.price_vnd)}{r.is_priority?' · Ưu tiên hiển thị':''}</p><p class="help">Gửi lúc {date(r.created_at)} · Mã {r.id}</p>{r.starts_at!=null&&r.expires_at!=null?<p class="help">Kỳ đã mua: {date(r.starts_at)} → {date(r.expires_at)}</p>:<p class="help">Chưa thu phí gia hạn.</p>}{r.review_note&&<p class="preserve">{r.review_note}</p>}{r.status==='pending'&&<button class="button secondary" type="button" data-renewal-cancel={r.id} data-version={r.version}>Hủy yêu cầu này</button>}</article>)}</div>}</section>
<section class="profile-card"><h2>Lịch sử trạng thái tin</h2>{data.events.length?<ol class="renewal-events">{data.events.map(e=><li><strong>{events[e.action]??'Cập nhật tin'}</strong><time>{date(e.created_at)}</time>{e.note&&<p class="preserve">{e.note}</p>}</li>)}</ol>:<p class="help">Chưa có thay đổi trạng thái.</p>}</section>
<dialog class="listing-state-dialog" data-renewal-cancel-dialog><h2>Hủy yêu cầu gia hạn?</h2><p>Yêu cầu này chưa được thu phí. Hủy sẽ không thay đổi thời hạn hoặc số dư hiện tại.</p><p class="alert" data-cancel-error hidden></p><div class="listing-state-buttons"><button type="button" class="button secondary" data-keep-renewal>Giữ yêu cầu</button><button type="button" class="button" data-confirm-cancel>Hủy yêu cầu</button></div></dialog>
</>}
</main><script>import '../../../../scripts/renewals';</script></AccountShell>
