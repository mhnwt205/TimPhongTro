---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RoomRow from '../components/RoomRow.astro';
import '../styles/search-layout.css';
import FilterForm from '../components/FilterForm.astro';
import Icon from '../components/Icon.astro';
import { filterRooms,areaName } from '../lib/rooms';
import {catalog} from '../lib/catalog';
const {rooms,areas}=await catalog();
const query=Astro.url.searchParams, results=filterRooms(query,rooms);
const requestedPage=Number(query.get('page')??1);
const page=Math.max(1,Math.min(Math.ceil(results.length/12)||1,Number.isSafeInteger(requestedPage)?requestedPage:1)),visible=results.slice((page-1)*12,page*12);
const change=(values:Record<string,string>)=>{const next=new URLSearchParams(query);next.delete('page');for(const [key,value] of Object.entries(values)){if(value)next.set(key,value);else next.delete(key);}return '/tim-phong?'+next;};
const priceLinks=[['Dưới 3 triệu','','3000000'],['3–5 triệu','3000000','5000000'],['5–7 triệu','5000000','7000000'],['Trên 7 triệu','7000000','']];
const sizes=[['Dưới 20 m²','0-20'],['20–30 m²','20-30'],['30–50 m²','30-50'],['Trên 50 m²','50-1000']];
const title=query.get('area') ? 'Phòng tại '+(areas.find(a=>a.id===query.get('area'))?.name??areaName(query.get('area')!)) : 'Tìm phòng tại TP.HCM';
const isFiltered=[...query.entries()].length>0;
---
<Base title={title+' — Tìm Phòng Trọ'} description="Tìm phòng trọ và căn hộ mini theo khu vực, giá thuê và tiện ích tại TP.HCM." robots={isFiltered?'noindex, follow':'index, follow'} canonical="/tim-phong">
  <SiteHeader active="browse"/>
  <main id="main-content" class="container rental-search"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><Icon name="chevron" size={12}/><span>Tìm phòng tại TP.HCM</span></nav>
    <form class="rental-search-bar" method="get" action="/tim-phong"><div class="rental-search-main"><label for="rental-keyword"><span>Tìm phòng theo đường, khu vực</span><input id="rental-keyword" type="search" name="q" value={query.get('q')??''} maxlength="120" placeholder="Bạn muốn tìm phòng ở đâu?"/></label><button class="button" type="submit"><Icon name="search" size={18}/>Tìm kiếm</button></div><div class="rental-search-options"><label><span>Khu vực</span><select name="area"><option value="">Toàn TP.HCM</option>{areas.map(a=><option value={a.id} selected={query.get('area')===a.id}>{a.name}</option>)}</select></label><label><span>Loại phòng</span><select name="type"><option value="">Tất cả loại phòng</option><option value="room" selected={query.get('type')==='room'}>Phòng trọ</option><option value="mini" selected={query.get('type')==='mini'}>Căn hộ mini</option></select></label><label><span>Giá thuê</span><select name="max"><option value="">Mọi mức giá</option>{[3000000,5000000,7000000].map(n=><option value={n} selected={query.get('max')===String(n)}>Đến {n/1000000} triệu/tháng</option>)}</select></label><label><span>Diện tích</span><select name="size"><option value="">Mọi diện tích</option>{sizes.map(([label,value])=><option value={value} selected={query.get('size')===value}>{label}</option>)}</select></label></div>{query.getAll('amenity').map(v=><input type="hidden" name="amenity" value={v}/>)}</form>
    <div class="search-workspace"><section class="results-sheet" aria-labelledby="results-title">
      <div class="results-title"><div><h1 id="results-title">{title}</h1><p>Chọn chỗ ở theo ngân sách và nhịp sống của bạn.</p></div><button type="button" class="button secondary mobile-filters-button" data-open-dialog="filter-dialog"><Icon name="filters" size={17}/>Bộ lọc</button></div>
      <div class="results-toolbar"><span class="help"><strong class="num" data-result-count>{results.length}</strong> phòng phù hợp</span><form method="get" class="sort-form" action="/tim-phong">{[...query.entries()].filter(([key])=>key!=='sort'&&key!=='page').map(([key,value])=><input type="hidden" name={key} value={value}/>)}<label for="sort">Sắp xếp</label><select id="sort" name="sort"><option value="">Mặc định</option><option value="price-asc" selected={query.get('sort')==='price-asc'}>Giá thấp đến cao</option><option value="price-desc" selected={query.get('sort')==='price-desc'}>Giá cao đến thấp</option><option value="area-desc" selected={query.get('sort')==='area-desc'}>Diện tích lớn nhất</option></select><button class="button secondary" type="submit">Xem</button></form></div>
      <nav class="rental-quick-filters" aria-label="Lọc nhanh">{priceLinks.slice(0,2).map(([label,min,max])=><a href={change({min,max})}>{label}</a>)}<a href={change({amenity:'loft'})}>Có gác</a><a href={change({amenity:'ac'})}>Máy lạnh</a><a href={change({amenity:'furnished'})}>Có nội thất</a></nav><div class="room-list">{results.length ? visible.map((room,i)=><RoomRow room={room} eager={i<2}/>) : <div class="empty-state"><Icon name="search" size={32}/><h2>Chưa tìm thấy phòng phù hợp</h2><p>Thử mở rộng khu vực hoặc thay đổi mức giá để xem thêm lựa chọn.</p><a href="/tim-phong" class="button secondary">Xem tất cả phòng</a></div>}</div>
    {results.length>12&&<nav class="rental-pagination" aria-label="Phân trang phòng"><span>Trang {page} / {Math.ceil(results.length/12)}</span>{page>1&&<a href={change({page:String(page-1)})}>← Trang trước</a>}{page*12<results.length&&<a href={change({page:String(page+1)})}>Trang sau →</a>}</nav>}</section><aside class="rental-sidebar" aria-label="Lọc phòng"><section><h2>Khoảng giá</h2>{priceLinks.map(([label,min,max])=><a href={change({min,max})}>{label}</a>)}</section><section><h2>Diện tích</h2>{sizes.map(([label,size])=><a href={change({size})}>{label}</a>)}</section><section><h2>Khu vực tại TP.HCM</h2>{areas.map(a=><a href={change({area:a.id})}>{a.name}</a>)}</section><details class="rental-more-filters"><summary>Bộ lọc chi tiết</summary><FilterForm prefix="desktop" areas={areas}/></details></aside></div>
  </main>
  <dialog id="filter-dialog" class="filter-dialog"><div class="dialog-top"><strong>Bộ lọc tìm phòng</strong><button class="icon-button" type="button" data-close-dialog aria-label="Đóng bộ lọc"><Icon name="close"/></button></div><FilterForm prefix="mobile" areas={areas}/></dialog>
  <SiteFooter/>
</Base>
