---
import AccountShell from '../../../layouts/AccountShell.astro';
import BankSelect from '../../../components/BankSelect.astro';
import FinanceConfirm from '../../../components/FinanceConfirm.astro';
import {type Withdrawal,type WalletSummary} from '@timphongtro/api';
import {financeRead,money,date,withdrawalLabels,type Page} from '../../../lib/finance';
const cookie=Astro.request.headers.get('cookie'),page=Astro.url.searchParams.get('page')??'1';
const [wallet,requests]=await Promise.all([financeRead<WalletSummary>('/api/account/wallet',Astro.url,cookie),financeRead<Page<Withdrawal>>('/api/account/withdrawals?page='+encodeURIComponent(page),Astro.url,cookie)]);
if(!wallet.data||!requests.data)Astro.response.status=wallet.data?requests.status:wallet.status;
const data=requests.data,balance=wallet.data;
---
<AccountShell title="Rút số dư" description="Gửi yêu cầu rút số dư về ngân hàng và theo dõi xử lý thủ công."><main id="main-content" class="account-main"><div class="page-heading"><h1>Rút số dư về ngân hàng</h1><p>Bạn gửi yêu cầu, quản trị viên kiểm tra và chuyển khoản thủ công.</p></div>
{!data||!balance?<p class="alert" role="alert">Chưa tải được số dư hoặc yêu cầu rút. Hãy tải lại trang.</p>:<>
<div class="finance-withdrawal-stats"><span>Số dư khả dụng<b>{money(balance.balance_vnd)}</b></span><span>Đang giữ để rút<b>{money(balance.held_vnd)}</b></span></div>
<p class="finance-notice"><strong>Giữ tiền ngay khi gửi yêu cầu</strong>Khoản rút được trừ khỏi số dư khả dụng để tránh sử dụng hai lần. Hủy trước khi được duyệt hoặc bị từ chối sẽ hoàn lại khoản giữ. Lượt đăng miễn phí không quy đổi thành tiền. Không thu phí rút; ngân hàng nhận cần đứng tên bạn.</p>
<section class="finance-panel finance-settings"><h2>Tạo yêu cầu rút</h2>{balance.balance_vnd<5000?<div class="finance-empty"><h3>Chưa đủ số dư khả dụng</h3><p>Mỗi yêu cầu từ 5.000đ đến 1.000.000đ. Bạn vẫn có thể theo dõi các yêu cầu đang xử lý bên dưới.</p></div>:<form method="post" data-finance-form data-endpoint="/api/account/withdrawals" data-confirm="withdrawal"><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="finance-grid-fields"><div class="field"><label for="withdraw-amount">Số tiền rút (VND)</label><input id="withdraw-amount" name="amount_vnd" type="number" min="5000" max={Math.min(balance.balance_vnd,1000000)} step="1" inputmode="numeric" required data-number/></div><BankSelect id="withdraw-bank" name="bank_code" label="Ngân hàng nhận" required/><div class="field"><label for="withdraw-number">Số tài khoản nhận</label><input id="withdraw-number" name="account_number" inputmode="numeric" pattern="[0-9]{6,24}" minlength="6" maxlength="24" required autocomplete="off"/></div><div class="field"><label for="withdraw-holder">Tên chủ tài khoản nhận</label><input id="withdraw-holder" name="account_holder" minlength="2" maxlength="100" required autocomplete="name" placeholder="Họ tên đầy đủ theo ngân hàng"/></div></div><div class="field"><label for="withdraw-note">Ghi chú (không bắt buộc)</label><textarea id="withdraw-note" name="note" rows="2" maxlength="500"/></div><div class="field"><label for="withdraw-password">Mật khẩu hiện tại</label><input id="withdraw-password" name="current_password" type="password" required maxlength="128" autocomplete="current-password"/></div><label class="finance-checkbox"><input type="checkbox" name="confirmed" required/><span>Tôi đã kiểm tra số tiền, ngân hàng và tài khoản nhận đứng tên tôi. Thông tin nhận tiền không thể sửa sau khi gửi.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button" type="submit">Kiểm tra và gửi yêu cầu rút</button><p class="help">Tối đa 3 yêu cầu đang chờ. Sau khi duyệt, bạn cần đợi quản trị viên xác nhận chuyển khoản thành công.</p></form>}</section>
<section class="finance-panel"><h2>Yêu cầu của bạn</h2>{!data.items.length?<div class="finance-empty"><h3>Chưa có yêu cầu rút</h3><p>Khi gửi yêu cầu, bạn sẽ nhận một mã RUT để theo dõi.</p></div>:<table class="cms-table finance-table"><thead><tr><th>Yêu cầu</th><th>Số tiền / nơi nhận</th><th>Trạng thái</th><th>Chi tiết</th></tr></thead><tbody>{data.items.map(r=><tr><td data-label="Yêu cầu"><strong>{r.code}</strong><small>{date(r.created_at)}</small></td><td data-label="Số tiền / nơi nhận" class="finance-number">{money(r.amount_vnd)}<small>{r.bank_name} · {r.account_number}</small></td><td data-label="Trạng thái"><span class={'finance-status '+r.status}>{withdrawalLabels[r.status]}</span></td><td data-label="Chi tiết"><a class="finance-open" href={'/tai-khoan/rut-tien/'+r.code}>Xem yêu cầu →</a></td></tr>)}</tbody></table>}<nav class="cms-pagination" aria-label="Phân trang yêu cầu rút"><span>{data.page>1&&<a href={'?page='+(data.page-1)}>← Trang trước</a>}</span><span>{data.total} yêu cầu</span>{data.page*data.page_size<data.total&&<a href={'?page='+(data.page+1)}>Trang sau →</a>}</nav></section></>}
</main><FinanceConfirm/><script>import '../../../scripts/finance';</script></AccountShell>
