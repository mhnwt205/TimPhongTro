---
import AccountShell from '../../layouts/AccountShell.astro';
import Icon from '../../components/Icon.astro';
import app,{type SellerProfile} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
const user=Astro.locals.user!;
const response=await app.fetch(new Request(new URL('/api/account/profile',Astro.url),{headers:{cookie:Astro.request.headers.get('cookie')??''}}),env);
if(response.status===401)return Astro.redirect('/dang-nhap');
const data=response.ok?await response.json() as {profile:SellerProfile|null;reviews:{decision:string;note:string;created_at:number}[];can_post:boolean}:null;
if(!data)Astro.response.status=503;
const p=data?.profile,status=p?.status??'new';
const labels={new:'Chưa gửi hồ sơ',pending:'Chờ xét duyệt',approved:'Đã duyệt hồ sơ',rejected:'Cần bổ sung'};
const names={new:'Bắt đầu với thông tin của bạn',pending:'Hồ sơ đang được kiểm tra',approved:'Sẵn sàng soạn tin phòng',rejected:'Cập nhật để gửi xét duyệt lại'};
const descriptions={new:'Chọn vai trò và thêm số liên hệ để gửi hồ sơ người đăng.',pending:'Bạn đã gửi hồ sơ. Kết quả sẽ được cập nhật tại đây sau khi quản trị viên kiểm tra.',approved:'Bạn đã được cấp quyền người đăng. Soạn tin và gửi kiểm duyệt trước khi xuất bản.',rejected:'Xem góp ý, chỉnh thông tin cần thiết rồi gửi lại hồ sơ.'};
const date=(n:number)=>new Date(n*1000).toLocaleString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'});
const display=p?.display_name??user.name,initial=display.trim().charAt(0).toUpperCase();
const completed=Number(display.trim().length>=2)+Number(Boolean(p?.seller_type))+Number(Boolean(p?.phone));
const error=Astro.url.searchParams.get('error');
---
<AccountShell title="Hồ sơ của tôi" description="Thông tin tài khoản, hồ sơ người đăng và kết quả xét duyệt của bạn."><main id="main-content" class="account-main profile-page"><header class="profile-heading"><div><h1>Hồ sơ của tôi</h1><p>Thông tin rõ ràng, bắt đầu một tin đăng tốt.</p></div><a class="profile-help-link" href="/dang-tin">Hướng dẫn đăng tin <Icon name="arrow" size={15}/></a></header>
{error&&<p class="alert" role="alert">{error}</p>}{user.email_verified_at==null&&<section class="finance-notice warning"><strong>Xác minh email trước khi gửi tin</strong><p>Hãy xác minh địa chỉ {user.email}. Bạn vẫn có thể hoàn thiện hồ sơ người đăng.</p><p class="alert" data-resend-error hidden role="alert"></p><p class="profile-success" data-resend-status hidden role="status"></p><button type="button" class="button secondary" data-email-resend>Gửi lại email xác minh</button></section>}{Astro.url.searchParams.has('updated')&&p&&<p class="profile-success" role="status">Đã lưu và gửi hồ sơ xét duyệt. Thông tin mới được cập nhật bên dưới.</p>}
{!data?<section class="profile-card profile-error"><Icon name="info" size={28}/><h2>Chưa tải được hồ sơ</h2><p>Hãy tải lại trang để kiểm tra thông tin của bạn.</p><a href="/tai-khoan/ho-so" class="button secondary">Tải lại hồ sơ</a></section>:<>
<section class="profile-overview" aria-label="Tóm tắt hồ sơ"><div class="profile-person"><span class="profile-avatar" aria-hidden="true">{initial}</span><div><h2>{display}</h2><p><Icon name="mail" size={15}/>{user.email}</p><span>{p?.seller_type==='owner'?'Chủ trọ / người cho thuê':p?.seller_type==='broker'?'Môi giới / saler':'Thành viên Tìm Phòng Trọ'}</span></div></div><div class={'profile-status '+status}><Icon name={status==='approved'?'user-check':status==='rejected'?'info':status==='pending'?'clock':'user'} size={16}/>{labels[status]}</div></section>
<div class="profile-layout"><section class={'profile-card profile-next-step '+status}><div class="profile-side-title"><Icon name={status==='approved'?'user-check':'clock'} size={20}/><h2>{names[status]}</h2></div><p>{descriptions[status]}</p>{p?.review_note&&<blockquote class="preserve">{p.review_note}</blockquote>}{p&&<p class="profile-updated">{status==='pending'?'Đã gửi':'Cập nhật'} {date(p.updated_at)}</p>}<a href="/tai-khoan/tin-dang/moi" class={'button '+(status==='approved'?'':'secondary')}>{status==='approved'?'Đăng tin mới':'Soạn bản nháp'}<Icon name="plus" size={16}/></a></section><div class="profile-main-column"><section class="profile-card profile-form-card" aria-labelledby="profile-form-title"><header><div><h2 id="profile-form-title">Thông tin người đăng</h2><p>Người thuê sẽ dùng thông tin liên hệ này khi tin của bạn được xuất bản.</p></div><Icon name="user" size={21}/></header>
<form method="post" action="/api/account/profile" data-profile-form data-profile-state={status}><input type="hidden" name="version" value={p?.version??0}/><fieldset class="profile-role"><legend>Bạn đăng tin với vai trò nào?</legend><div><label><input type="radio" name="seller_type" value="owner" checked={p?.seller_type==='owner'} required/><span><Icon name="home" size={20}/><strong>Chủ trọ</strong><small>Cho thuê phòng trực tiếp</small></span></label><label><input type="radio" name="seller_type" value="broker" checked={p?.seller_type==='broker'} required/><span><Icon name="user" size={20}/><strong>Môi giới / saler</strong><small>Hỗ trợ người thuê tìm phòng</small></span></label></div></fieldset>
<div class="field"><label for="display-name">Tên hiển thị</label><input id="display-name" name="display_name" value={display} required minlength="2" maxlength="100" autocomplete="name" aria-describedby="display-name-help"/><small id="display-name-help">Tên bạn muốn người thuê nhìn thấy trên thông tin liên hệ.</small></div>
<div class="profile-contact-fields"><div class="field"><label for="phone">Số điện thoại</label><input id="phone" name="phone" type="tel" inputmode="tel" value={p?.phone??''} required maxlength="20" autocomplete="tel" placeholder="090 123 4567" aria-describedby="phone-help"/><small id="phone-help">Số di động Việt Nam đang sử dụng.</small></div><div class="field"><label for="zalo">Số Zalo <span class="profile-optional">(tùy chọn)</span></label><input id="zalo" name="zalo_phone" type="tel" inputmode="tel" value={p?.zalo_phone===p?.phone?'':p?.zalo_phone??''} maxlength="20" placeholder="Để trống nếu cùng số điện thoại" aria-describedby="zalo-help"/><small id="zalo-help">Bỏ trống để dùng số điện thoại bên cạnh.</small></div></div>
<div class="field"><label for="intro">Giới thiệu ngắn <span class="profile-optional">(tùy chọn)</span></label><textarea id="intro" name="introduction" rows="4" maxlength="600" placeholder="Ví dụ: Tôi có phòng tại Bình Thạnh và Thủ Đức, thuận tiện liên hệ sau 18h." aria-describedby="intro-help">{p?.introduction??''}</textarea><div class="profile-field-foot"><small id="intro-help">Khu vực có phòng, thời gian liên hệ hoặc điều bạn muốn giới thiệu.</small><span data-profile-counter>{(p?.introduction??'').length}/600</span></div></div>
{p?.status==='approved'&&<p class="profile-inline-notice"><Icon name="info" size={17}/><span>Khi thay đổi thông tin, hồ sơ sẽ chuyển về chờ xét duyệt. Gửi lại nội dung không thay đổi sẽ giữ kết quả hiện tại.</span></p>}
<p class="alert" role="alert" data-profile-error hidden></p><div class="profile-save-bar"><div><strong data-profile-save-caption>{p?'Thông tin đã lưu':'Chưa gửi hồ sơ'}</strong><span data-profile-dirty-note>{p?'Chỉnh sửa thông tin khi cần cập nhật.':'Kiểm tra số liên hệ trước khi gửi.'}</span></div><button class="button" type="submit">{p?'Cập nhật và gửi xét duyệt':'Gửi hồ sơ xét duyệt'}<Icon name="arrow" size={16}/></button></div><p class="profile-private-note"><Icon name="lock" size={14}/>Không nhập mật khẩu, OTP hoặc thông tin ngân hàng vào phần giới thiệu.</p></form></section>
<section class="profile-card profile-history" aria-labelledby="profile-history-title"><header><div><h2 id="profile-history-title">Lịch sử xét duyệt</h2><p>Kết quả kiểm tra hồ sơ người đăng của bạn.</p></div><Icon name="clock" size={20}/></header>{data.reviews.length?<ol>{data.reviews.map(r=><li><span class={'profile-history-marker '+r.decision}><Icon name={r.decision==='approved'?'check':'info'} size={14}/></span><div><strong>{r.decision==='approved'?'Hồ sơ đã được duyệt':'Cần bổ sung thông tin'}</strong><time datetime={new Date(r.created_at*1000).toISOString()}>{date(r.created_at)}</time>{r.note&&<p class="preserve">{r.note}</p>}</div></li>)}</ol>:<p class="profile-history-empty">Chưa có kết quả xét duyệt. Các phản hồi sẽ xuất hiện tại đây sau khi quản trị viên kiểm tra hồ sơ.</p>}</section>
</div><aside class="profile-side-column">
<section class="profile-card profile-completion"><h2>Thông tin cơ bản</h2><p><strong data-profile-completed>{completed}/3</strong> mục đã điền</p><progress max="3" value={completed} data-profile-progress aria-label="Số mục thông tin cơ bản đã điền"/><ul><li data-profile-check="name"><Icon name={display.trim().length>=2?'check':'user'} size={16}/>Tên hiển thị</li><li data-profile-check="role"><Icon name={p?.seller_type?'check':'user'} size={16}/>Vai trò người đăng</li><li data-profile-check="phone"><Icon name={p?.phone?'check':'user'} size={16}/>Số điện thoại</li></ul></section>
<section class="profile-card profile-preview" id="profile-contact-preview"><h2>Xem trước liên hệ</h2><div><span class="profile-preview-avatar" aria-hidden="true" data-profile-initial>{initial}</span><div><strong data-profile-preview-name>{display}</strong><span data-profile-preview-role>{p?.seller_type==='owner'?'Chủ trọ':p?.seller_type==='broker'?'Môi giới / saler':'Chưa chọn vai trò'}</span></div></div><p><Icon name="phone" size={16}/><span data-profile-preview-phone>{p?.phone??'Chưa thêm số điện thoại'}</span></p><p><Icon name="message" size={16}/><span data-profile-preview-zalo>{p?.zalo_phone?'Zalo: '+p.zalo_phone:'Zalo dùng cùng số điện thoại'}</span></p><p class="profile-fine-print">Liên hệ này hiển thị trên các tin đã được duyệt của bạn.</p></section>
<section class="profile-card profile-security-link"><Icon name="lock" size={20}/><div><h2>Bảo mật tài khoản</h2><p>Email đăng nhập và mật khẩu được quản lý riêng.</p><a href="/tai-khoan/bao-mat">Đổi mật khẩu <Icon name="arrow" size={15}/></a></div></section>
</aside></div></>}
</main><script>import '../../scripts/profile';import '../../scripts/email-actions';</script></AccountShell>
