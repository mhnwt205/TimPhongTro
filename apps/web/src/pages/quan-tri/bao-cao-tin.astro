---
import CmsLayout from '../../layouts/CmsLayout.astro';
import {can,reportReasons,type ListingReport} from '@timphongtro/api';
import {financeRead,date,type Page} from '../../lib/finance';
const status=Astro.url.searchParams.get('status')??'waiting',q=Astro.url.searchParams.get('q')??'',page=Astro.url.searchParams.get('page')??'1';
const {data,status:responseStatus}=await financeRead<Page<ListingReport>>('/api/cms/reports?'+new URLSearchParams({status,q,page}),Astro.url,Astro.request.headers.get('cookie'));
if(!data)Astro.response.status=responseStatus;
const labels={open:'Mới tiếp nhận',reviewing:'Đang kiểm tra',resolved:'Đã xử lý',dismissed:'Không đủ căn cứ'};
const filters=[['waiting','Cần xử lý'],...Object.entries(labels),['all','Tất cả']];
const pageUrl=(n:number)=>'?'+new URLSearchParams({status,q,page:String(n)});
---
<CmsLayout title="Báo cáo tin đăng" description="Kiểm tra phản ánh về nội dung và lưu kết quả xử lý."><main id="main-content"><div class="cms-heading"><div><h1>Báo cáo tin đăng</h1><p>Đọc phản ánh, đối chiếu nội dung và ghi rõ kết quả kiểm tra.</p></div></div><section class="cms-sheet"><form method="get" class="cms-filters"><label>Tìm mã hoặc tên tin<input name="q" value={q} maxlength="100"/></label><label>Trạng thái<select name="status">{filters.map(([value,label])=><option value={value} selected={status===value}>{label}</option>)}</select></label><button class="button secondary" type="submit">Tìm / lọc</button></form>{!data?<p class="alert" role="alert">Chưa tải được báo cáo. Kiểm tra bộ lọc và thử lại.</p>:<><p class="help">{data.total} báo cáo · Trang {data.page}</p><div class="report-list">{data.items.length?data.items.map(r=><article class="report-card"><div class="seller-top"><div><h2>{r.listing_title}</h2><p class="help">{r.code} · {date(r.created_at)}{r.is_sample?' · Tin tham khảo':''}</p></div><span class="cms-badge">{labels[r.status]}</span></div><p><strong>{reportReasons[r.reason]}</strong></p><p class="preserve">{r.details}</p>{r.contact_email&&<p class="help">Email liên hệ riêng: {r.contact_email}</p>}<a class="text-link" href={'/phong/'+r.listing_id} target="_blank" rel="noopener">Mở tin để kiểm tra →</a>{r.review_note&&<p class="report-notice preserve"><strong>Ghi chú xử lý: </strong>{r.review_note}</p>}{can(Astro.locals.user,'reports.review')&&<details class="moderation"><summary>Cập nhật kết quả kiểm tra</summary><form method="post" data-report-review data-endpoint={'/api/cms/reports/'+r.id+'/review'}><input type="hidden" name="version" value={r.version}/><div class="field"><label for={'status-'+r.id}>Trạng thái sau khi kiểm tra</label><select id={'status-'+r.id} name="status"><option value="reviewing" selected={r.status==='reviewing'}>Đang kiểm tra</option><option value="resolved" selected={r.status==='resolved'}>Đã xử lý</option><option value="dismissed" selected={r.status==='dismissed'}>Không đủ căn cứ</option></select></div><div class="field"><label for={'note-'+r.id}>Ghi chú xử lý</label><textarea id={'note-'+r.id} name="note" rows="3" minlength="5" maxlength="1000" required/></div><p class="help">Trạng thái báo cáo không tự gỡ tin. Kiểm tra và xử lý nội dung tại nghiệp vụ tin đăng tương ứng.</p><p class="alert" role="alert" data-report-error hidden></p><button class="button" type="submit">Lưu kết quả kiểm tra</button></form></details>}</article>):<div class="finance-empty"><h2>Chưa có báo cáo phù hợp</h2><p>Phản ánh mới sẽ xuất hiện tại đây khi người dùng gửi từ trang chi tiết tin.</p></div>}</div><nav class="cms-pagination" aria-label="Phân trang báo cáo"><span>{data.page>1&&<a href={pageUrl(data.page-1)}>← Trang trước</a>}</span>{data.page*data.page_size<data.total&&<a href={pageUrl(data.page+1)}>Trang sau →</a>}</nav></>}</section></main><script>import '../../scripts/reports';</script></CmsLayout>
