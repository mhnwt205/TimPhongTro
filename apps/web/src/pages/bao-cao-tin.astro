---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageBanner from '../components/PageBanner.astro';
import {reportReasons} from '@timphongtro/api';
import '../styles/account.css';
import {publicRooms} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
const published=await publicRooms(env.DB);
const room=published.find(r=>r.id===Astro.url.searchParams.get('tin'));
if(!room)return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control','private, no-store');
---
<Base title={'Báo cáo tin '+room.title+' — Tìm Phòng Trọ'} description="Gửi phản ánh về thông tin tin đăng để Tìm Phòng Trọ kiểm tra."><SiteHeader/><main id="main-content" class="container wide-page"><PageBanner title="Báo cáo nội dung tin" description="Cung cấp thông tin cụ thể để chúng tôi kiểm tra và xử lý phản ánh."/><section class="report-panel"><h2>{room.title}</h2><a class="text-link" href={'/phong/'+room.id}>← Xem lại tin đang báo cáo</a><p class="report-notice">Thông tin liên hệ chỉ dành cho bộ phận quản trị, không hiển thị công khai.</p><form method="post" action="/api/listing-reports" data-report-form><input type="hidden" name="listing_id" value={room.id}/><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="field"><label for="report-reason">Vấn đề bạn gặp</label><select id="report-reason" name="reason" required><option value="">Chọn lý do</option>{Object.entries(reportReasons).map(([value,label])=><option value={value}>{label}</option>)}</select></div><div class="field"><label for="report-details">Mô tả chi tiết</label><textarea id="report-details" name="details" minlength="10" maxlength="2000" rows="5" required placeholder="Nêu thông tin chưa đúng hoặc dấu hiệu cần kiểm tra. Không gửi mật khẩu, OTP hay thông tin nhạy cảm."/></div><div class="field"><label for="report-email">Email liên hệ (không bắt buộc)</label><input id="report-email" name="contact_email" type="email" maxlength="254" autocomplete="email"/><small>Chỉ cung cấp nếu bạn muốn quản trị viên có thể liên hệ làm rõ.</small></div><div class="report-honeypot" aria-hidden="true"><label for="report-website">Website<input id="report-website" name="website" tabindex="-1" autocomplete="off"/></label></div><p class="alert" role="alert" data-report-error hidden></p><button class="button" type="submit">Gửi báo cáo</button><noscript><p class="help">Trình duyệt đang chặn biểu mẫu báo cáo. Hãy kiểm tra cài đặt rồi tải lại trang.</p></noscript></form><div data-report-success hidden role="status"><h2>Đã ghi nhận báo cáo</h2><p>Mã tra cứu: <strong data-report-code></strong></p><p>Chúng tôi sẽ kiểm tra phản ánh. Gửi báo cáo không đồng nghĩa tin đã được xác định vi phạm hoặc tự động bị gỡ.</p><a class="button secondary" href={'/phong/'+room.id}>Quay lại tin đăng</a></div></section></main><SiteFooter/><script>import '../scripts/reports';</script></Base>
