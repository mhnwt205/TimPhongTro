---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import { money } from '../lib/rooms';
import app,{ type ListingPlan } from '@timphongtro/api';
import { env } from 'cloudflare:workers';
import {getWebsiteSettings} from '@timphongtro/api';
const response=await app.fetch(new Request(new URL('/api/plans',Astro.url)),env);
const plans=response.ok ? (await response.json() as { items: ListingPlan[] }).items : null;
if(!plans)Astro.response.status=503;
const copy=await getWebsiteSettings(env.DB);
const faqs=[1,2,3,4].map(i=>({question:copy[`faq_${i}_question` as keyof typeof copy] as string,answer:copy[`faq_${i}_answer` as keyof typeof copy] as string})).filter(item=>item.question.trim()&&item.answer.trim());
---
<Base title={copy.pricing_banner_title+' — Trọ Tốt TP.HCM'} description={copy.pricing_banner_body} robots={plans?.length?'index, follow':'noindex, follow'}><SiteHeader active="pricing"/><main id="main-content" class="container wide-page"><PageBanner title={copy.pricing_banner_title} description={copy.pricing_banner_body}/>
  {plans ? <div class="pricing-layout" data-plan-count={plans.length===1?'one':plans.length===2?'two':'many'}>{plans.map(plan=><article class="pricing-card"><h2>{plan.name}</h2><div class="price">{money(plan.price_vnd)}</div><p>Thời hạn hiển thị: {plan.duration_days} ngày.</p>{plan.description?.trim()?<p class="pricing-plan-description">{plan.description}</p>:null}{plan.is_priority===1?<p class="pricing-plan-priority"><Icon name="check" size={17}/>Ưu tiên trong kết quả tìm phòng</p>:null}<a class="button secondary full" href="/dang-tin">Tìm hiểu cách đăng tin<Icon name="arrow" size={16}/></a></article>)}</div> : <div class="empty-state"><h2>Chưa tải được bảng giá</h2><p>Vui lòng thử lại sau.</p><a class="button secondary" href="/bang-gia">Thử lại</a></div>}
  <section class="pricing-note"><Icon name="info" size={22}/><div><h2>{copy.free_posts_title.replaceAll('{{free_posts}}',String(copy.free_posts_new_account))}</h2><p>{copy.free_posts_body.replaceAll('{{free_posts}}',String(copy.free_posts_new_account))}</p></div></section>
  <section class="faq-list" aria-labelledby="faq-title"><h2 id="faq-title">{copy.faq_title}</h2>{faqs.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
</main><SiteFooter/></Base>
