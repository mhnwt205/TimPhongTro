---
import CmsLayout from '../../../layouts/CmsLayout.astro';
import FinanceConfirm from '../../../components/FinanceConfirm.astro';
import TopupTimeline from '../../../components/TopupTimeline.astro';
import {can,type Topup,type BankAccount} from '@timphongtro/api';
import {financeRead,money,date,topupLabels,type Event} from '../../../lib/finance';
type SepayException={id:string;provider_reference:string;amount_vnd:number;currency:string;outcome:string;note:string;received_at:number};
type Detail={topup:Topup&{user_name:string;user_email:string;is_locked:number;user_deleted_at:number|null};events:Event[];accounts:BankAccount[];sepay_exception:SepayException|null;receipt:{actual_vnd:number;bank_reference:string;provider:string;provider_transaction_id:string|null;note:string;created_at:number;reviewer_name:string;bank_name:string;account_number:string}|null};
const {data,status}=await financeRead<Detail>('/api/cms/topups/'+encodeURIComponent(Astro.params.id??''),Astro.url,Astro.request.headers.get('cookie'));
if(status===404)return Astro.rewrite('/404');if(!data)Astro.response.status=status;
const t=data?.topup,editable=can(Astro.locals.user,'topups.reconcile')&&t?.user_id!==Astro.locals.user!.id;
const sepayException=data?.sepay_exception,canReviewException=Boolean(editable&&sepayException&&(t?.payment_provider==='sepay_pg'||sepayException.outcome==='legacy_request')&&['amount_mismatch','cancelled_request','request_not_pending','legacy_request'].includes(sepayException.outcome));
---
<CmsLayout title="Chi tiết yêu cầu nạp" description="Theo dõi thanh toán tự động và các giao dịch cần kiểm tra."><main id="main-content"><a class="finance-back" href="/quan-tri/nap-tien">← Danh sách nạp tiền</a><div class="finance-page-heading"><div><h1>{t?.code??'Chi tiết yêu cầu'}</h1><p>{t?.user_name} · {t?.user_email}</p></div>{t&&<span class={'finance-status '+t.status}>{topupLabels[t.status]}</span>}</div>
{!t||!data?<p class="alert" role="alert">Không tải được chi tiết yêu cầu nạp. Tải lại trang hoặc quay lại danh sách.</p>:<div class="finance-layout"><div><section class="finance-panel" style="margin-top:0"><h2>Thông tin yêu cầu</h2><dl class="finance-details"><div><dt>Số tiền yêu cầu</dt><dd class="finance-number">{money(t.requested_vnd)}</dd></div>{t.payment_provider==='sepay_pg'?<div><dt>Thanh toán</dt><dd>SePay · {t.code}</dd></div>:<><div><dt>Ngân hàng / tài khoản</dt><dd>{t.bank_name} · {t.account_number}</dd></div><div><dt>Chủ tài khoản nhận</dt><dd>{t.account_holder}</dd></div><div><dt>Nội dung chuyển khoản</dt><dd class="finance-transfer-content">{t.code}</dd></div></>}<div><dt>Thời điểm tạo</dt><dd>{date(t.created_at)}</dd></div></dl>{t.customer_note&&<p class="finance-notice preserve"><strong>Ghi chú người đăng</strong>{t.customer_note}</p>}{t.review_note&&<p class="finance-notice warning preserve"><strong>Thông tin xử lý</strong>{t.review_note}</p>}{Boolean(t.is_locked||t.user_deleted_at)&&<p class="finance-notice warning">Tài khoản người đăng hiện đã khóa hoặc xóa mềm. Lịch sử giao dịch vẫn được giữ.</p>}</section>
{sepayException&&<section class="finance-panel"><h2>Giao dịch SePay cần kiểm tra</h2><p class="finance-notice warning"><strong>{money(sepayException.amount_vnd)} · {sepayException.currency}</strong>{sepayException.note}</p><dl class="finance-details"><div><dt>Mã giao dịch SePay</dt><dd>{sepayException.provider_reference}</dd></div><div><dt>Nhận lúc</dt><dd>{date(sepayException.received_at)}</dd></div></dl>{canReviewException&&<form method="post" data-finance-form data-endpoint={'/api/cms/topups/'+t.id+'/reconcile'} data-confirm="reconcile" data-beneficiary={t.user_name+' · '+t.user_email}><input type="hidden" name="version" value={t.version} data-number/><input type="hidden" name="actual_vnd" value={sepayException.amount_vnd} data-number/><input type="hidden" name="bank_account_id" value={t.bank_account_id}/><input type="hidden" name="bank_reference" value={sepayException.provider_reference}/><input type="hidden" name="provider_transaction_id" value={sepayException.provider_reference}/><input type="hidden" name="exception_confirmed" value="true"/><div class="field"><label for="sepay-review-note">Lý do xác nhận cộng khoản ngoại lệ</label><textarea id="sepay-review-note" name="note" rows="3" required minlength="10" maxlength="1000"/></div><label class="finance-checkbox"><input type="checkbox" name="verified" required/><span>Tôi đã kiểm tra giao dịch này trong SePay và xác nhận số tiền thực nhận.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button full" type="submit">Xác nhận và cộng số tiền thực nhận</button></form>}</section>}
{data.receipt?<section class="finance-panel"><h2>Khoản nhận đã ghi nhận</h2><dl class="finance-details"><div><dt>Tiền thực nhận</dt><dd class="finance-number">{money(data.receipt.actual_vnd)}</dd></div><div><dt>Mã giao dịch</dt><dd>{data.receipt.provider==='sepay_pg'?data.receipt.provider_transaction_id:data.receipt.bank_reference}</dd></div><div><dt>Nguồn xác nhận</dt><dd>{data.receipt.provider==='sepay_pg'?'SePay tự động':'Quản trị viên'}</dd></div><div><dt>Người ghi nhận</dt><dd>{data.receipt.reviewer_name} · {date(data.receipt.created_at)}</dd></div></dl><p class="help">Thông tin đã ghi nhận được giữ nguyên. Sai sót được xử lý bằng bút toán điều chỉnh có ghi lý do.</p></section>:editable&&t.payment_provider==='manual'&&sepayException?.outcome!=='legacy_request'&&<section class="finance-panel"><h2>Ghi nhận khoản nhận cũ</h2><p class="help">Yêu cầu này được tạo trước khi chuyển sang SePay.</p><form method="post" data-finance-form data-endpoint={'/api/cms/topups/'+t.id+'/reconcile'} data-confirm="reconcile" data-beneficiary={t.user_name+' · '+t.user_email}><input type="hidden" name="version" value={t.version} data-number/><div class="field"><label for="actual-vnd">Số tiền thực nhận (VND)</label><input id="actual-vnd" name="actual_vnd" type="number" inputmode="numeric" min="1" max="1000000" step="1" value={t.requested_vnd} required data-number/></div><div class="field"><label for="received-account">Tài khoản nhận</label><select id="received-account" name="bank_account_id" required>{data.accounts.map(a=><option value={a.id} selected={a.id===t.bank_account_id}>{a.bank_name} · {a.account_number}</option>)}</select></div><div class="field"><label for="bank-reference">Mã giao dịch ngân hàng</label><input id="bank-reference" name="bank_reference" required minlength="4" maxlength="100" autocomplete="off"/></div><div class="field"><label for="receipt-note">Ghi chú / lý do ngoại lệ</label><textarea id="receipt-note" name="note" maxlength="1000" rows="3"/></div><label class="finance-checkbox"><input type="checkbox" name="exception_confirmed"/><span>Đã xác minh khoản tiền lệch số tiền, khác tài khoản nhận hoặc đến sau khi hủy.</span></label><label class="finance-checkbox"><input type="checkbox" name="verified" required/><span>Tôi đã đối chiếu giao dịch ngân hàng thực tế.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button full" type="submit">Ghi nhận khoản thực nhận</button></form></section>}
{t.status!=='credited'&&editable&&t.payment_provider==='manual'&&<section class="finance-panel"><h2>Xử lý yêu cầu cũ</h2><form method="post" data-finance-form data-endpoint={'/api/cms/topups/'+t.id+'/review'} data-confirm="review"><input type="hidden" name="version" value={t.version} data-number/><div class="field"><label for="review-action">Trạng thái xử lý</label><select id="review-action" name="action"><option value="needs_review">Cần kiểm tra thêm</option><option value="cancelled">Hủy yêu cầu chưa nhận tiền</option></select></div><div class="field"><label for="review-note">Lý do</label><textarea id="review-note" name="note" rows="3" required minlength="5" maxlength="1000"/></div><p class="help">Lịch sử các yêu cầu cũ được giữ để tra cứu.</p><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button secondary" type="submit">Lưu trạng thái xử lý</button></form></section>}
</div><aside class="finance-panel" style="margin-top:0"><h2>Lịch sử yêu cầu</h2><TopupTimeline events={data.events}/></aside></div>}
</main><FinanceConfirm/><script>import '../../../scripts/finance';</script></CmsLayout>
