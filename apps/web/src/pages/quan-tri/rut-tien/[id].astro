---
import CmsLayout from '../../../layouts/CmsLayout.astro';
import BankSelect from '../../../components/BankSelect.astro';
import FinanceConfirm from '../../../components/FinanceConfirm.astro';
import WithdrawalDetails from '../../../components/WithdrawalDetails.astro';
import TopupTimeline from '../../../components/TopupTimeline.astro';
import {can,receivingBanks,type Withdrawal,type WithdrawalPayout} from '@timphongtro/api';
import {financeRead,money,date,withdrawalLabels,withdrawalEventLabels,type Event} from '../../../lib/finance';
type Detail={withdrawal:Withdrawal;events:Event[];payout:WithdrawalPayout|null;qr_available:boolean};
const {data,status}=await financeRead<Detail>('/api/cms/withdrawals/'+encodeURIComponent(Astro.params.id??''),Astro.url,Astro.request.headers.get('cookie'));
if(status===404)return Astro.rewrite('/404');if(!data)Astro.response.status=status;
const r=data?.withdrawal,other=r?.user_id!==Astro.locals.user!.id;
const mine=r?.processor_id===Astro.locals.user!.id;
const review=other&&can(Astro.locals.user,'withdrawals.review'),pay=other&&can(Astro.locals.user,'withdrawals.pay');
const activePayout=pay&&mine&&r?.status==='approved';
---
<CmsLayout title="Xử lý yêu cầu rút" description="Duyệt yêu cầu và xác nhận chuyển khoản ngân hàng thủ công."><main id="main-content"><a class="finance-back" href="/quan-tri/rut-tien">← Danh sách yêu cầu rút</a><div class="finance-page-heading"><div><h1>{r?.code??'Yêu cầu rút'}</h1><p>{r?.user_name} · {r?.user_email}</p></div>{r&&<span class={'finance-status '+r.status}>{withdrawalLabels[r.status]}</span>}</div>
{!data||!r?<p class="alert" role="alert">Không tải được chi tiết yêu cầu rút. Tải lại trang hoặc quay lại danh sách yêu cầu rút.</p>:<div class="finance-layout"><div>{pay&&mine&&r.status==='approved'&&<section class="finance-panel" style="margin-top:0" data-withdrawal-qr-panel data-detail-url={'/api/cms/withdrawals/'+r.id} data-version={r.version} data-processor={r.processor_id}><h2>Chuyển khoản cho người dùng</h2><p class="help">Bạn đang xử lý yêu cầu này.</p>{Boolean(r.is_locked||r.user_deleted_at)&&<p class="finance-notice warning">Tài khoản người dùng đã bị khóa hoặc xóa. Kiểm tra kỹ khoản đã chuyển trước khi xác nhận hoặc từ chối để hoàn khoản giữ.</p>}{data.qr_available?<><div class="finance-qr" data-withdrawal-qr-content><div class="finance-qr-image"><img src={'/api/cms/withdrawals/'+r.id+'/qr?version='+r.version} width="300" height="300" alt={'VietQR chuyển '+money(r.amount_vnd)+' đến '+r.bank_name+', tài khoản '+r.account_number+', nội dung '+r.code} data-withdrawal-qr/></div><div><h3>Quét QR để chuyển cho người dùng</h3><p>Dùng ứng dụng ngân hàng quét mã hoặc lưu ảnh QR rồi chọn ảnh trong ứng dụng.</p><p>Điền sẵn <strong>{money(r.amount_vnd)}</strong> đến <strong>{r.account_holder}</strong> · {r.bank_name} · {r.account_number}.</p><p class="help">Nội dung chuyển khoản: <strong>{r.code}</strong>.</p><p class="help">Yêu cầu tạo {date(r.created_at)}.</p><p class="help">Kiểm tra tên người nhận trong ứng dụng ngân hàng trước khi xác nhận.</p><button type="button" class="button secondary" hidden data-download-withdrawal-qr data-qr-filename={r.code}>Lưu ảnh QR</button><p class="help">Chuyển một lần cho yêu cầu này. Sau khi ngân hàng báo thành công, nhập mã giao dịch và xác nhận bên dưới.</p></div></div><p class="finance-notice warning" role="status" hidden data-withdrawal-qr-error></p></>:<><WithdrawalDetails withdrawal={r}/><p class="finance-notice warning">Ngân hàng này chưa hỗ trợ QR. Chuyển khoản bằng thông tin nhận tiền ở trên, nội dung <strong>{r.code}</strong>.</p></>}{data.qr_available&&r.customer_note&&<p class="finance-notice preserve"><strong>Ghi chú của người dùng</strong>{r.customer_note}</p>}</section>}
{!activePayout&&<section class="finance-panel" style="margin-top:0"><h2>Thông tin chuyển cho người dùng</h2><WithdrawalDetails withdrawal={r}/><p class="help">Chuyển đúng tài khoản và đúng số tiền đã lưu. Website không tự chuyển tiền; nút duyệt chỉ giữ chỗ xử lý. Nếu từ chối yêu cầu, khoản tiền đang giữ sẽ tự hoàn về số dư.</p>{Boolean(r.is_locked||r.user_deleted_at)&&<p class="finance-notice warning">Người dùng đã bị khóa hoặc xóa mềm. Không duyệt yêu cầu mới; vẫn xử lý khoản đã chuyển hoặc từ chối để hoàn khoản giữ, giữ nguyên lịch sử.</p>}</section>}
{review&&r.status==='pending'&&!r.is_locked&&!r.user_deleted_at&&<section class="finance-panel"><h2>Duyệt yêu cầu</h2><form method="post" data-finance-form data-endpoint={'/api/cms/withdrawals/'+r.id+'/review'} data-confirm="withdrawal-approve"><input type="hidden" name="version" value={r.version} data-number/><input type="hidden" name="action" value="approved"/><label class="finance-checkbox"><input type="checkbox" name="confirmed" required/><span>Tôi đã kiểm tra yêu cầu và thông tin nhận tiền. Chuyển sang hàng chờ chuyển khoản thủ công.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button" type="submit">Duyệt và chờ chuyển khoản</button></form></section>}
{r.status==='approved'&&!activePayout&&<section class="finance-panel"><h2>Người xử lý chuyển khoản</h2>{r.processor_id?<p class="finance-notice"><strong>{r.processor_name}</strong>{mine?'Bạn đang giữ quyền xử lý yêu cầu này. Kiểm tra giao dịch trước khi chuyển.':'Quản trị viên này đã nhận xử lý. Không tự chuyển khoản để tránh chuyển trùng.'}</p>:<p class="help">Chưa có người nhận xử lý. Nhận yêu cầu trước khi chuyển tiền qua ngân hàng.</p>}{pay&&!r.processor_id&&<form method="post" data-finance-form data-endpoint={'/api/cms/withdrawals/'+r.id+'/claim'} data-confirm="withdrawal-claim"><input type="hidden" name="version" value={r.version} data-number/><input type="hidden" name="confirmed" value="true"/><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button" type="submit">Nhận xử lý chuyển khoản</button></form>}</section>}
{pay&&mine&&r.status==='approved'&&<section class="finance-panel"><h2>Xác nhận đã chuyển khoản</h2><p class="finance-notice warning">Chỉ xác nhận khi ngân hàng báo chuyển thành công đến {r.account_holder} · {r.account_number}. Nếu kết quả giao dịch chưa rõ, giữ trạng thái này để kiểm tra; không từ chối hoặc chuyển lại.</p><form method="post" data-finance-form data-endpoint={'/api/cms/withdrawals/'+r.id+'/pay'} data-confirm="withdrawal-pay" data-beneficiary={r.account_holder+' · '+r.bank_name+' · '+r.account_number}><input type="hidden" name="version" value={r.version} data-number/><div class="field"><label for="payout-amount">Số tiền đã chuyển (VND)</label><input id="payout-amount" name="amount_vnd" type="number" min={r.amount_vnd} max={r.amount_vnd} value={r.amount_vnd} required data-number/><small>Phải bằng đúng {money(r.amount_vnd)}. Không xác nhận khoản chuyển thiếu.</small></div><div class="finance-grid-fields"><BankSelect id="payout-bank" name="sender_bank_code" label="Ngân hàng đã dùng để chuyển" required/><div class="field"><label for="payout-number">Số tài khoản đã chuyển</label><input id="payout-number" name="sender_account_number" inputmode="numeric" pattern="[0-9]{6,24}" minlength="6" maxlength="24" required autocomplete="off"/></div></div><div class="field"><label for="payout-reference">Mã giao dịch chuyển tiền ngân hàng</label><input id="payout-reference" name="bank_reference" minlength="4" maxlength="100" required autocomplete="off"/></div><div class="field"><label for="payout-note">Ghi chú (không bắt buộc)</label><textarea id="payout-note" name="note" rows="2" maxlength="1000"/></div><label class="finance-checkbox"><input type="checkbox" name="verified" required/><span>Tôi đã đối chiếu sao kê và ngân hàng xác nhận chuyển thành công đúng người nhận, số tài khoản và số tiền.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button" type="submit">Kiểm tra và xác nhận đã chuyển</button></form></section>}
{data.payout&&<section class="finance-panel"><h2>Giao dịch đã xác nhận</h2><dl class="finance-details"><div><dt>Đã chuyển</dt><dd>{money(data.payout.amount_vnd)}</dd></div><div><dt>Mã giao dịch ngân hàng</dt><dd>{data.payout.bank_reference}</dd></div><div><dt>Tài khoản chuyển</dt><dd>{receivingBanks.find(b=>b[0]===data.payout!.sender_bank_code)?.[1]??data.payout.sender_bank_code} · {data.payout.sender_account_number}</dd></div><div><dt>Người xác nhận</dt><dd>{data.payout.actor_name} · {date(data.payout.created_at)}</dd></div></dl><p class="help">Lịch sử xác nhận được giữ nguyên. Không trừ số dư lần nữa vì đã giữ tiền khi người dùng gửi yêu cầu.</p></section>}
{pay&&mine&&r.status==='approved'&&<section class="finance-panel"><h2>Nhả xử lý cho người khác</h2><form method="post" data-finance-form data-endpoint={'/api/cms/withdrawals/'+r.id+'/claim'} data-confirm="withdrawal-release"><input type="hidden" name="version" value={r.version} data-number/><input type="hidden" name="confirmed" value="true"/><label class="finance-checkbox"><input type="checkbox" name="release" required/><span>Nhả quyền xử lý yêu cầu.</span></label><label class="finance-checkbox"><input type="checkbox" name="not_transferred" required/><span>Chắc chắn chưa chuyển tiền và không có giao dịch đang chờ hoặc chưa rõ kết quả.</span></label><div class="field"><label for="release-note">Lý do nhả xử lý</label><textarea id="release-note" name="note" rows="2" required minlength="10" maxlength="1000"/></div><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button secondary" type="submit">Nhả xử lý, giữ yêu cầu đang chờ</button></form></section>}
{review&&(!r.processor_id||mine)&&['pending','approved'].includes(r.status)&&<section class="finance-panel"><h2>Từ chối và hoàn khoản giữ</h2><form method="post" data-finance-form data-endpoint={'/api/cms/withdrawals/'+r.id+'/review'} data-confirm="withdrawal-reject"><input type="hidden" name="version" value={r.version} data-number/><input type="hidden" name="action" value="rejected"/><div class="field"><label for="reject-note">Lý do gửi cho người dùng</label><textarea id="reject-note" name="note" rows="3" required minlength="10" maxlength="1000"/></div><label class="finance-checkbox"><input type="checkbox" name="not_transferred" required/><span>Tôi đã kiểm tra và chắc chắn chưa chuyển tiền, không có giao dịch đang chờ hoặc chưa rõ kết quả.</span></label><label class="finance-checkbox"><input type="checkbox" name="confirmed" required/><span>Xác nhận từ chối và hoàn {money(r.amount_vnd)} vào số dư khả dụng.</span></label><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button secondary" type="submit">Từ chối và hoàn khoản giữ</button></form></section>}
</div><aside class="finance-panel" style="margin-top:0"><h2>Lịch sử xử lý</h2><TopupTimeline events={data.events} labels={withdrawalEventLabels}/></aside></div>}
</main><FinanceConfirm/><script>import '../../../scripts/finance';import '../../../scripts/withdrawal-qr';</script></CmsLayout>
