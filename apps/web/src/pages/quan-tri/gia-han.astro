---
import CmsLayout from '../../layouts/CmsLayout.astro';
import app,{can,type Renewal} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
import {money,date} from '../../lib/finance';
import '../../styles/renewals.css';
const status=Astro.url.searchParams.get('status')??'pending',page=Astro.url.searchParams.get('page')??'1';
const response=await app.fetch(new Request(new URL('/api/cms/renewals?'+new URLSearchParams({status,page}),Astro.url),{headers:{cookie:Astro.request.headers.get('cookie')??''}}),env);
if(response.status===403)return Astro.rewrite('/403');
type Row=Renewal&{owner_name:string;owner_email:string;title:string;listing_version:number;listing_expires_at:number;display_state:string;moderation_hidden:number;deleted_at:number|null};
const data=response.ok?await response.json() as {items:Row[];total:number;page:number;page_size:number}:null;if(!data)Astro.response.status=response.status;
const labels={pending:'Chờ duyệt',approved:'Đã gia hạn',rejected:'Bị từ chối',cancelled:'Đã hủy'},url=(n:number)=>'/quan-tri/gia-han?'+new URLSearchParams({status,page:String(n)});
---
<CmsLayout title="Gia hạn tin" description="Duyệt yêu cầu gia hạn và ghi nhận phí đúng một lần."><main id="main-content"><header class="cms-heading"><div><h1>Gia hạn tin</h1><p>Đối chiếu gói và thời hạn. Chỉ trừ số dư khi duyệt thành công.</p></div></header><section class="cms-sheet"><form class="cms-filters" method="get"><label>Trạng thái<select name="status">{[['pending','Chờ duyệt'],['approved','Đã gia hạn'],['rejected','Bị từ chối'],['cancelled','Đã hủy'],['all','Tất cả']].map(([value,label])=><option value={value} selected={status===value}>{label}</option>)}</select></label><button type="submit" class="button secondary">Lọc yêu cầu</button></form>
{!data?<p class="alert">Không tải được danh sách yêu cầu gia hạn. Kiểm tra trạng thái đang lọc rồi tải lại trang.</p>:<><p class="help">{data.total} yêu cầu · Trang {data.page}</p><div class="renewal-history">{data.items.map(r=><article><div class="renewal-card-heading"><h2>{r.title}</h2><span class="cms-badge">{labels[r.status]}</span></div><p>{r.owner_name} · {r.owner_email}</p><dl class="renewal-summary"><div><dt>Gói yêu cầu</dt><dd>{r.plan_name}{r.is_priority?' · Ưu tiên hiển thị':''}</dd></div><div><dt>Phí / thời gian thêm</dt><dd>{money(r.price_vnd)} · {r.duration_days} ngày</dd></div><div><dt>Hạn hiện tại</dt><dd>{date(r.listing_expires_at)}</dd></div><div><dt>Gửi lúc</dt><dd>{date(r.created_at)}</dd></div></dl>{r.starts_at!=null&&r.expires_at!=null?<p class="help">Kỳ đã mua: {date(r.starts_at)} → {date(r.expires_at)}</p>:<p class="help">Nếu duyệt lúc này: từ {date(Math.max(r.listing_expires_at,Math.floor(Date.now()/1000)))} đến {date(Math.max(r.listing_expires_at,Math.floor(Date.now()/1000))+r.duration_days*86400)}. Gói mới có hiệu lực từ đầu kỳ gia hạn.</p>}{r.review_note&&<p class="preserve">{r.review_note}</p>}{r.moderation_hidden||r.deleted_at?<p class="finance-notice warning">Tin đang bị gỡ hoặc đã xóa. Không thể duyệt gia hạn.</p>:null}
{r.status==='pending'&&can(Astro.locals.user,'renewals.review')&&r.owner_id!==Astro.locals.user?.id&&<form class="renewal-review" data-renewal-review data-id={r.id} data-version={r.version} data-listing-version={r.listing_version}><div class="field"><label for={'renewal-decision-'+r.id}>Kết quả</label><select id={'renewal-decision-'+r.id} name="decision"><option value="approved">Duyệt, trừ phí và cộng hạn</option><option value="rejected">Từ chối yêu cầu</option></select></div><div class="field"><label for={'renewal-note-'+r.id}>Ghi chú / lý do từ chối</label><textarea id={'renewal-note-'+r.id} name="note" rows="3" maxlength="1000"/></div><label class="finance-checkbox"><input type="checkbox" name="confirmed"/><span>Tôi đã kiểm tra gói {r.plan_name}, đồng ý thu {money(r.price_vnd)} và thêm {r.duration_days} ngày. Tin đang ẩn/hết phòng vẫn giữ trạng thái đó.</span></label><p class="alert" data-renewal-error hidden role="alert"></p><button class="button" type="submit">Lưu kết quả gia hạn</button></form>}
</article>)}</div>{!data.items.length&&<p class="finance-empty">Chưa có yêu cầu phù hợp.</p>}<nav class="cms-pagination"><span>{data.page>1&&<a href={url(data.page-1)}>← Trang trước</a>}</span>{data.page*data.page_size<data.total&&<a href={url(data.page+1)}>Trang sau →</a>}</nav></>}
</section></main><script>import '../../scripts/renewals';</script></CmsLayout>
