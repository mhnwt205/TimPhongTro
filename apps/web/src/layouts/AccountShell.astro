---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Icon from '../components/Icon.astro';
import '../styles/account.css';
import '../styles/finance.css';
import '../styles/profile.css';
interface Props { title:string;description:string;admin?:boolean }
const {title,description}=Astro.props,user=Astro.locals.user!,path=Astro.url.pathname;
const groups=[{label:'Tài khoản của bạn',items:[['/tai-khoan/ho-so','Hồ sơ của tôi','user'],['/tai-khoan/tin-dang','Tin đăng của tôi','list'],['/tai-khoan/tin-dang/moi','Đăng tin mới','plus']]},{label:'Số dư & thanh toán',items:[['/tai-khoan/so-du','Số dư đăng tin','wallet'],['/tai-khoan/nap-tien','Yêu cầu nạp tiền','plus'],['/tai-khoan/rut-tien','Yêu cầu rút tiền','arrow']]},{label:'Tiện ích',items:[['/tai-khoan/thong-bao','Thông báo','bell'],['/tai-khoan/bao-mat','Bảo mật tài khoản','lock'],['/tim-phong','Khám phá phòng','search'],...(user.cms_access?[['/quan-tri','Trang quản trị','shield']]:[])]}];
const current=(href:string)=>href==='/tai-khoan/tin-dang'?path.startsWith(href)&&!path.endsWith('/moi'):path===href||!href.endsWith('/moi')&&path.startsWith(href+'/');
const tabs=[['/tai-khoan/ho-so','Hồ sơ','user'],['/tai-khoan/tin-dang','Tin đăng','list'],['/tai-khoan/so-du','Số dư','wallet'],['/tai-khoan/thong-bao','Thông báo','bell'],['/tai-khoan/bao-mat','Bảo mật','lock']];
const tabActive=(href:string)=>href==='/tai-khoan/so-du'?['/tai-khoan/so-du','/tai-khoan/nap-tien','/tai-khoan/rut-tien'].some(p=>path.startsWith(p)):path.startsWith(href);
---
<Base title={title+' — Tìm Phòng Trọ'} description={description}><SiteHeader/><div class="account-frame account-workspace"><aside class="account-sidebar" aria-label="Điều hướng tài khoản"><div class="account-identity"><span class="account-avatar" aria-hidden="true">{user.name.charAt(0).toUpperCase()}</span><div><strong>{user.name}</strong><small>Tài khoản Tìm Phòng Trọ</small></div></div><nav>{groups.map(group=><div class="account-nav-group"><p>{group.label}</p>{group.items.map(([href,label,icon])=><a href={href} class={current(href)?'active':''} aria-current={current(href)?'page':undefined}><Icon name={icon} size={18}/>{label}</a>)}</div>)}</nav><form method="post" action="/api/auth/logout"><button class="sidebar-logout" type="submit"><Icon name="logout" size={17}/>Đăng xuất</button></form></aside><div class="account-sheet"><div class="account-mobile-top"><span><Icon name="user" size={16}/>Tài khoản của bạn</span><form method="post" action="/api/auth/logout"><button class="text-button" type="submit">Đăng xuất</button></form></div><nav class="finance-account-tabs" aria-label="Điều hướng người đăng">{tabs.map(([href,label,icon])=><a href={href} aria-current={tabActive(href)?'page':undefined}><Icon name={icon} size={16}/>{label}</a>)}</nav><slot/></div></div></Base>
