{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "timphongtro-email-test",
  "main": "../apps/api/src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RESEND_API_KEY": "re_test_only",
    "EMAIL_FROM": "Trọ Tốt TP.HCM <noreply@example.test>",
    "EMAIL_VERIFICATION_REQUIRED": "true",
    "EMAIL_TEST_CAPTURE": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "timphongtro-email-test",
    "database_id": "00000000-0000-0000-0000-000000000016",
    "migrations_dir": "../apps/api/migrations"
  }],
  "r2_buckets": [{
    "binding": "LISTING_IMAGES",
    "bucket_name": "timphongtro-email-test-images"
  }]
}
