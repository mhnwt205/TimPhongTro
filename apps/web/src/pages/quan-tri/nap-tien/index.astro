---
import CmsLayout from '../../../layouts/CmsLayout.astro';
import FinanceConfirm from '../../../components/FinanceConfirm.astro';
import Icon from '../../../components/Icon.astro';
import {can,type PaymentSettings,type Topup} from '@timphongtro/api';
import {financeRead,money,date,topupLabels,type Page} from '../../../lib/finance';
type Row=Topup&{user_name:string;user_email:string;is_locked:number;user_deleted_at:number|null};
type Exception={id:string;provider_reference:string;order_invoice_number:string;amount_vnd:number;currency:string;outcome:string;note:string;received_at:number;topup_id:string|null;topup_code:string|null;topup_status:string|null;user_name:string|null;user_email:string|null};
const status=Astro.url.searchParams.get('status')??'waiting',q=Astro.url.searchParams.get('q')??'',page=Astro.url.searchParams.get('page')??'1';
const canSeeTopups=can(Astro.locals.user,'topups.read'),canSeePayments=can(Astro.locals.user,'payments.read');
if(!canSeeTopups&&!canSeePayments)return Astro.redirect('/quan-tri');
const [topupsResult,exceptionsResult,paymentsResult]=await Promise.all([canSeeTopups?financeRead<Page<Row>>('/api/cms/topups?'+new URLSearchParams({status,q,page}),Astro.url,Astro.request.headers.get('cookie')):Promise.resolve({data:null,status:403}),canSeeTopups?financeRead<{items:Exception[]}>('/api/cms/sepay-exceptions',Astro.url,Astro.request.headers.get('cookie')):Promise.resolve({data:{items:[] as Exception[]},status:200}),canSeePayments?financeRead<{settings:PaymentSettings;sepay:{configured:boolean;environment:'sandbox'|'production'|null}}>('/api/cms/payments',Astro.url,Astro.request.headers.get('cookie')):Promise.resolve({data:null,status:200})]);
const {data,status:responseStatus}=topupsResult,{data:exceptionData}=exceptionsResult,{data:paymentData}=paymentsResult;
const exceptions=exceptionData?.items??[];
if(canSeeTopups&&!data)Astro.response.status=responseStatus;
const paymentConfig=paymentData?.settings,canEditPayments=can(Astro.locals.user,'payments.update');
const filters=[['waiting','Cần kiểm tra'],['reported','Tin cũ: đã chuyển'],['needs_review','Cần kiểm tra'],['pending','Chờ thanh toán'],['credited','Đã cộng số dư'],['cancelled','Đã hủy'],['all','Tất cả']];
const url=(page:number)=>'?'+new URLSearchParams({status,q,page:String(page)});
---
<CmsLayout title="Nạp tiền qua SePay" description="Theo dõi thanh toán và xử lý các giao dịch cần kiểm tra."><main id="main-content"><div class="cms-heading"><div><h1>Nạp tiền qua SePay</h1><p>Theo dõi các yêu cầu nạp và khoản cần kiểm tra.</p></div></div>
{canSeePayments&&<section class="finance-settings" aria-labelledby="sepay-settings-title">{!paymentConfig?<p class="alert" role="alert">Không tải được trạng thái nhận tiền. Tải lại trang để thử lại.</p>:<div class="finance-panel"><h2 id="sepay-settings-title">Nhận tiền qua SePay</h2><p class="help">{paymentData?.sepay.configured?`Đã kết nối ${paymentData.sepay.environment==='sandbox'?'Sandbox':'Production'}. Giao dịch đúng mã và số tiền được cộng tự động.`:'SePay chưa sẵn sàng; chưa thể nhận yêu cầu nạp.'}{canSeeTopups?' Khoản lệch sẽ xuất hiện bên dưới để kiểm tra.':''}</p><form method="post" data-finance-form data-endpoint="/api/cms/payments" data-confirm="settings"><input type="hidden" name="version" value={paymentConfig.version} data-number/><label class="finance-checkbox"><input type="checkbox" name="accepting_topups" checked={Boolean(paymentConfig.accepting_topups)} disabled={!canEditPayments}/><span>Cho phép người đăng đã duyệt tạo yêu cầu nạp</span></label><p class="help">Cài đặt này chỉ áp dụng cho yêu cầu mới.</p><p class="cms-form-error" data-finance-error role="alert" hidden></p>{canEditPayments&&<button class="button" type="submit">Lưu cấu hình <Icon name="check" size={16}/></button>}</form></div>}</section>}
{canSeeTopups&&<>{exceptions.length>0&&<section class="cms-sheet" aria-labelledby="sepay-exception-title"><div class="cms-heading"><div><h2 id="sepay-exception-title">Giao dịch cần kiểm tra</h2><p>SePay đã xác nhận giao dịch nhưng chưa thể ghép đúng với yêu cầu nạp.</p></div><span class="finance-status needs_review">{exceptions.length} khoản</span></div><div class="cms-table-wrap"><table class="cms-table finance-table"><thead><tr><th>Đơn / người đăng</th><th>Tiền nhận</th><th>Lý do</th><th>Thời gian</th><th>Thao tác</th></tr></thead><tbody>{exceptions.map(e=><tr><td data-label="Đơn / người đăng"><strong>{e.order_invoice_number}</strong>{e.user_name&&<p>{e.user_name}</p>}{e.user_email&&<small>{e.user_email}</small>}<small>Mã giao dịch: {e.provider_reference}</small></td><td data-label="Tiền nhận" class="finance-number">{money(e.amount_vnd)}<small>{e.currency}</small></td><td data-label="Lý do">{e.note}</td><td data-label="Thời gian">{date(e.received_at)}</td><td data-label="Thao tác">{e.topup_id&&<a class="finance-open" href={'/quan-tri/nap-tien/'+e.topup_id}>Mở yêu cầu <Icon name="chevron" size={14}/></a>}{(!e.topup_id||e.outcome==='already_credited')?<form data-sepay-exception-form data-endpoint={'/api/cms/sepay-exceptions/'+e.id+'/review'}><label class="visually-hidden" for={'sepay-review-'+e.id}>Ghi chú đã kiểm tra giao dịch {e.order_invoice_number}</label><input id={'sepay-review-'+e.id} name="note" required minlength="5" maxlength="1000" placeholder="Ghi chú kiểm tra"/><p class="cms-form-error" data-sepay-exception-error role="alert" hidden></p><button class="button secondary" type="submit">Lưu ghi chú</button></form>:<p class="help">Mở yêu cầu để đối chiếu và xử lý.</p>}</td></tr>)}</tbody></table></div><p class="help">Lưu ghi chú chỉ đánh dấu đã kiểm tra, không cộng tiền vào ví.</p></section>}
<section class="cms-sheet"><form method="get" class="cms-filters"><label>Tìm mã / người đăng<input name="q" value={q} maxlength="100"/></label><label>Trạng thái<select name="status">{filters.map(([value,label])=><option value={value} selected={status===value}>{label}</option>)}</select></label><button class="button secondary" type="submit">Tìm / lọc</button></form>
{!data?<p class="alert" role="alert">Không tải được yêu cầu nạp. Kiểm tra bộ lọc và thử lại.</p>:<><p class="finance-filter-info">{data.total} yêu cầu · Trang {data.page}</p>{data.items.length?<table class="cms-table finance-table"><thead><tr><th>Yêu cầu / người đăng</th><th>Số tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>{data.items.map(t=><tr><td data-label="Yêu cầu / người đăng"><strong>{t.code}</strong><p>{t.user_name}</p><small>{t.user_email}</small><small>{date(t.created_at)}</small>{Boolean(t.is_locked||t.user_deleted_at)&&<small>Tài khoản {t.user_deleted_at?'đã xóa mềm':'đã khóa'}; lịch sử được giữ.</small>}</td><td data-label="Số tiền" class="finance-number">{money(t.requested_vnd)}{t.credited_vnd!==null&&<small>Đã ghi nhận {money(t.credited_vnd)}</small>}</td><td data-label="Trạng thái"><span class={'finance-status '+t.status}>{topupLabels[t.status]}</span></td><td data-label="Thao tác"><a class="finance-open" href={'/quan-tri/nap-tien/'+t.id}>Xem yêu cầu <Icon name="chevron" size={14}/></a></td></tr>)}</tbody></table>:<div class="finance-empty"><h3>Không có yêu cầu trong danh sách này</h3><p>Yêu cầu sẽ xuất hiện khi người đăng tạo mã thanh toán.</p></div>}<nav class="cms-pagination" aria-label="Phân trang yêu cầu nạp"><span>{data.page>1&&<a href={url(data.page-1)}>← Trang trước</a>}</span>{data.page*data.page_size<data.total&&<a href={url(data.page+1)}>Trang sau →</a>}</nav></>}
</section></>}
</main><FinanceConfirm/><script>import '../../../scripts/finance';import '../../../scripts/sepay-exceptions';</script></CmsLayout>
