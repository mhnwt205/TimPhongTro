---
import AuthLayout from '../layouts/AuthLayout.astro';
import Icon from '../components/Icon.astro';
if(Astro.locals.user)return Astro.redirect('/tai-khoan/ho-so');
const error=Astro.url.searchParams.get('error');
---
<AuthLayout title="Tạo tài khoản" heading="Tạo tài khoản người đăng" intro="Dành cho chủ trọ và môi giới. Tạo hồ sơ để bắt đầu kết nối với người thuê.">
  {error && <p class="alert" role="alert">{error}</p>}
  <form method="post" action="/api/auth/register" class="auth-form">
    <div class="field"><label for="name">Tên của bạn</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Nhập họ và tên"/></div>
    <div class="field"><label for="email">Email</label><div class="input-with-icon"><Icon name="mail" size={18}/><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="Địa chỉ email của bạn"/></div></div>
    <div class="field"><label for="password">Mật khẩu</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" aria-describedby="password-help" placeholder="Tạo mật khẩu của bạn"/><button class="icon-button" type="button" data-toggle-password="password" aria-label="Hiện mật khẩu" aria-pressed="false"><Icon name="eye" size={18}/></button></div><small id="password-help">Từ 12–128 ký tự. Có thể dùng một cụm từ dài, dễ nhớ.</small></div>
    <div class="field"><label for="password-confirmation">Nhập lại mật khẩu</label><div class="password-field"><input id="password-confirmation" name="password_confirmation" type="password" autocomplete="new-password" required minlength="12" maxlength="128" placeholder="Nhập lại để xác nhận"/><button class="icon-button" type="button" data-toggle-password="password-confirmation" aria-label="Hiện mật khẩu xác nhận" aria-pressed="false"><Icon name="eye" size={18}/></button></div></div>
    <button class="button full" type="submit">Tạo tài khoản<Icon name="arrow" size={17}/></button>
  </form><p class="auth-switch">Đã có tài khoản? <a href="/dang-nhap">Đăng nhập</a></p><p class="auth-small">Vui lòng dùng địa chỉ email đang hoạt động để nhận thông tin từ Tìm Phòng Trọ. Tìm phòng không cần tài khoản; hồ sơ người đăng sẽ được xét duyệt trước khi cấp quyền đăng.</p>
</AuthLayout>
