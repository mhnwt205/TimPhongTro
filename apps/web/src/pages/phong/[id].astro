---
import '../../styles/maps.css';
import {mapEmbed,mapLink} from '../../../../shared/maps';
import ListingDisclaimer from '../../components/ListingDisclaimer.astro';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RoomCard from '../../components/RoomCard.astro';
import Icon from '../../components/Icon.astro';
import { areaName,rentLabel,money,amenities } from '../../lib/rooms';
import {catalog} from '../../lib/catalog';
import {inactiveListing} from '@timphongtro/api';
import {env} from 'cloudflare:workers';
const {rooms:allRooms}=await catalog();
const room=allRooms.find(item=>item.id===Astro.params.id);
if(!room){const inactive=await inactiveListing(env.DB,Astro.params.id??'');return Astro.rewrite(inactive?'/phong/'+encodeURIComponent(inactive.id)+'/trang-thai':'/404');}
const baseCost=room.rent+room.service+room.parking;
const waterUnit=room.water_unit??'per_person';
const related=allRooms.filter(item=>item.id!==room.id).slice(0,4);
const galleryImages=room.images?.length?room.images.map(id=>'/api/listing-images/'+encodeURIComponent(id)):Array.from({length:3},(_,index)=>'/images/room-'+((room.photo+index)%4)+'.webp');
---
<Base title={room.title+' — Phòng trọ tại '+(room.areaLabel??areaName(room.area))} description={room.description} robots="index, follow" image={galleryImages[0]} imageAlt={room.title+' — ảnh phòng cho thuê'}>
  <SiteHeader active="browse"/><main id="main-content" class="container"><nav class="breadcrumbs" aria-label="Đường dẫn"><a href="/">Trang chủ</a><Icon name="chevron" size={12}/><a href="/tim-phong">Tìm phòng</a><Icon name="chevron" size={12}/><a href={'/tim-phong?area='+room.area}>{room.areaLabel??areaName(room.area)}</a></nav>
    <div class="detail-gallery" data-detail-gallery data-images={JSON.stringify(galleryImages)} data-title={room.title} aria-label="Bộ sưu tập ảnh phòng"><div class="detail-gallery-stage"><button type="button" class="detail-gallery-main" data-gallery-zoom aria-label="Mở ảnh lớn"><img data-gallery-current src={galleryImages[0]} alt={room.title+' — ảnh 1'} width="1200" height="675" fetchpriority="high"/><span class="detail-gallery-type">{room.type==='mini'?'Căn hộ mini':'Phòng trọ'}</span>{room.is_priority&&<span class="detail-gallery-priority">Ưu tiên hiển thị</span>}<span class="detail-gallery-expand"><Icon name="expand" size={17}/></span></button>{galleryImages.length>1&&<><button type="button" class="detail-gallery-arrow previous" data-gallery-prev aria-label="Xem ảnh trước"><Icon name="chevron" size={25}/></button><button type="button" class="detail-gallery-arrow next" data-gallery-next aria-label="Xem ảnh tiếp theo"><Icon name="chevron" size={25}/></button></>}</div><div class="detail-gallery-thumbs" data-gallery-thumbs aria-label="Chọn ảnh">{galleryImages.map((src,index)=><button type="button" class="detail-gallery-thumb" data-gallery-select={index} aria-label={'Hiển thị ảnh '+(index+1)} aria-current={index===0?'true':undefined}><img src={src} alt="" width="180" height="105" loading={index<5?'eager':'lazy'} decoding="async"/></button>)}</div></div>
    <dialog class="photo-viewer" data-photo-viewer aria-label="Bộ sưu tập ảnh phòng"><div class="photo-viewer-top"><span data-photo-counter></span><button class="icon-button" type="button" data-photo-close aria-label="Đóng bộ sưu tập ảnh"><Icon name="close" size={22}/></button></div><div class="photo-viewer-stage"><button class="photo-viewer-arrow" type="button" data-photo-prev aria-label="Xem ảnh trước"><Icon name="chevron" size={24}/></button><img data-photo-current alt=""/><button class="photo-viewer-arrow next" type="button" data-photo-next aria-label="Xem ảnh tiếp theo"><Icon name="chevron" size={24}/></button></div><div class="photo-viewer-thumbs" data-photo-thumbs aria-label="Chọn ảnh"></div></dialog>
    <div class="detail-layout"><article class="detail-sheet"><span class="detail-type">{room.type==='mini'?'Căn hộ mini':'Phòng trọ'}</span><h1>{room.title}</h1><p class="detail-location"><Icon name="pin" size={16}/>{room.street}, {room.areaLabel??areaName(room.area)}, TP.HCM</p><div class="detail-price-row"><div class="detail-price num">{rentLabel(room.rent)} <span>/tháng</span></div><button class="button secondary" type="button" data-save-room={room.id} data-room-title={room.title} aria-pressed="false" title="Lưu phòng yêu thích"><Icon name="heart" size={18}/><span data-save-label>Lưu phòng</span></button></div>
      <dl class="detail-facts"><div><Icon name="area" size={23}/><div><dt>Diện tích</dt><dd class="num">{room.size} m²</dd></div></div><div><Icon name="user" size={23}/><div><dt>Số người</dt><dd>{room.people} người</dd></div></div><div><Icon name="bed" size={23}/><div><dt>Nội thất</dt><dd>{room.amenities.includes('furnished')?'Có sẵn':'Cơ bản'}</dd></div></div></dl>
      <section class="detail-section"><h2>Về không gian này</h2><p>{room.description}</p></section>
      <section class="detail-section"><h2>Tiện ích trong phòng</h2><div class="amenity-grid">{amenities.filter(item=>room.amenities.includes(item.id)).map(item=><span><Icon name="check" size={17}/>{item.name}</span>)}</div></section>
      <section class="detail-section"><h2>Các khoản chi phí</h2><table class="cost-table"><tbody><tr><td>Tiền thuê</td><td>{money(room.rent)}/tháng</td></tr><tr><td>Tiền cọc</td><td>{money(room.deposit)}</td></tr><tr><td>Điện</td><td>{money(room.electricity)}/kWh</td></tr><tr><td>Nước</td><td>{money(room.water)}{waterUnit==='per_m3'?'/m³':'/người/tháng'}</td></tr><tr><td>Dịch vụ</td><td>{money(room.service)}/tháng</td></tr><tr><td>Gửi xe</td><td>{money(room.parking)}/xe/tháng</td></tr></tbody></table>
        <div class="calculator" data-cost-calculator data-base-cost={baseCost} data-electricity={room.electricity} data-water={room.water} data-water-unit={waterUnit}><label for="electricity-usage">Điện dự kiến mỗi tháng <input id="electricity-usage" type="number" min="0" max="500" step="10" value="80"/> kWh</label>{waterUnit==='per_person'&&<label for="water-people">Số người ở dự kiến <input id="water-people" type="number" min="1" max="20" step="1" value="1"/></label>}{waterUnit==='per_m3'&&<label for="water-usage">Nước dự kiến mỗi tháng <input id="water-usage" type="number" min="0" max="100" step="0.1" placeholder="Nhập mức dùng"/> m³</label>}<p><span>Ước tính tổng mỗi tháng</span><output for={waterUnit==='per_m3'?'electricity-usage water-usage':'electricity-usage water-people'}>{money(baseCost+80*room.electricity+(waterUnit==='per_person'?room.water:0))}</output></p><small>Ước tính theo tiền thuê, tiện ích, số người và mức dùng nước đã nhập; chưa tính tiền cọc.</small></div>
      </section><section class="detail-section"><h2>{room.street.startsWith('Khu vực ')?'Khu vực gần đúng':'Vị trí phòng'}</h2><p>{room.street}, {room.areaLabel??areaName(room.area)}, TP.HCM</p><iframe class="public-room-map" title={'Vị trí '+room.title} src={mapEmbed(room.map_point?`${room.map_point.lat},${room.map_point.lng}`:`${room.street}, ${room.areaLabel??areaName(room.area)}, TP.HCM`)} loading="lazy" referrerpolicy="no-referrer" allowfullscreen/><a class="text-link" href={mapLink(room.map_point?`${room.map_point.lat},${room.map_point.lng}`:`${room.street}, ${room.areaLabel??areaName(room.area)}, TP.HCM`)} target="_blank" rel="noopener noreferrer">Mở đường đi trên Google Maps ↗</a></section><ListingDisclaimer title={room.title} listingId={room.id} />
    </article><aside class="contact-panel"><h2>Liên hệ người đăng</h2>{room.seller?<><p>{room.seller.name}</p><a class="button full" href={'tel:'+room.seller.phone}>Gọi {room.seller.phone}</a><a class="button secondary full" href={'https://zalo.me/'+room.seller.zalo.replace(/^0/,'84')} target="_blank" rel="noopener">Nhắn Zalo</a></>:<p>Người đăng chưa cập nhật thông tin liên hệ.</p>}<a href={'/tim-phong?area='+room.area} class="button secondary full">Xem phòng cùng khu vực</a><div class="contact-note"><strong>Trước khi thuê phòng</strong><p>Đến xem trực tiếp, xác nhận tất cả chi phí và đọc kỹ điều khoản trước khi chuyển tiền đặt cọc.</p></div></aside></div>
    <section class="section" aria-labelledby="related-title"><div class="section-heading"><h2 id="related-title">Thêm lựa chọn cho bạn</h2><a class="text-link" href="/tim-phong">Xem tất cả<Icon name="arrow" size={16}/></a></div><div class="room-grid related-grid">{related.map(item=><RoomCard room={item}/>)}</div></section>
  </main><SiteFooter/><script>import '../../scripts/detail-gallery';</script>
</Base>
