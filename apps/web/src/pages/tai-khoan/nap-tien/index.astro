---
import AccountShell from '../../../layouts/AccountShell.astro';
import Icon from '../../../components/Icon.astro';
import type {WalletSummary,Topup} from '@timphongtro/api';
import {financeRead,money,date,topupLabels,type Page} from '../../../lib/finance';
const cookie=Astro.request.headers.get('cookie');
const [{data},{data:requests}]=await Promise.all([financeRead<WalletSummary>('/api/account/wallet',Astro.url,cookie),financeRead<Page<Topup>>('/api/account/topups?page='+(Astro.url.searchParams.get('page')??'1'),Astro.url,cookie)]);
if(!data||!requests)Astro.response.status=503;
---
<AccountShell title="Yêu cầu nạp tiền" description="Nạp số dư qua thanh toán trực tuyến và theo dõi trạng thái trong tài khoản."><main id="main-content" class="account-main"><div class="page-heading"><h1>Yêu cầu nạp tiền</h1><p>Thanh toán qua SePay. Số dư được cộng tự động sau khi giao dịch thành công.</p></div>
{!data||!requests?<p class="alert" role="alert">Không tải được số dư hoặc danh sách yêu cầu nạp. Tải lại trang để kiểm tra trạng thái hiện tại.</p>:<>
{!data.payments_enabled?<div class="finance-notice warning" role="status"><strong>Chưa thể nạp tiền</strong>Chức năng thanh toán đang tạm thời chưa khả dụng. Vui lòng quay lại sau.</div>:data.profile_status!=='approved'?<div class="finance-notice"><strong>Cần được duyệt quyền đăng trước khi nạp</strong>Hoàn thiện hồ sơ người đăng và chờ xét duyệt. <a class="text-link" href="/tai-khoan/ho-so">Xem hồ sơ <Icon name="arrow" size={15}/></a></div>:<section class="finance-panel"><h2>Tạo yêu cầu mới</h2><noscript><p class="finance-notice warning">Trình duyệt đang chặn biểu mẫu. Hãy kiểm tra cài đặt rồi tải lại trang.</p></noscript><p class="help">Số dư hiện tại: <strong>{money(data.balance_vnd)}</strong>. Mỗi tài khoản có tối đa 3 yêu cầu đang chờ.</p><form method="post" data-finance-form data-endpoint="/api/account/topups"><input type="hidden" name="request_key" value={crypto.randomUUID()}/><div class="field" style="margin-top:20px"><label for="topup-amount">Số tiền muốn nạp (VND)</label><input id="topup-amount" name="amount_vnd" type="number" inputmode="numeric" min="5000" max="1000000" step="1" required data-number/><small>Từ 5.000đ đến 1.000.000đ, số nguyên VND.</small></div><div class="finance-amounts">{[5000,10000,50000,100000,200000].map(n=><button type="button" data-topup-amount={n}>{money(n)}</button>)}</div><p class="cms-form-error" data-finance-error role="alert" hidden></p><button class="button" type="submit">Tạo yêu cầu và thanh toán <Icon name="arrow" size={16}/></button></form></section>}
<section class="finance-panel"><h2>Lịch sử yêu cầu nạp</h2>{requests.items.length?<table class="cms-table finance-table"><thead><tr><th>Mã yêu cầu</th><th>Số tiền</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>{requests.items.map(t=><tr><td data-label="Mã yêu cầu"><a class="finance-open" href={'/tai-khoan/nap-tien/'+t.code}>{t.code}</a></td><td data-label="Số tiền" class="finance-number">{money(t.requested_vnd)}{t.credited_vnd!==null&&t.credited_vnd!==t.requested_vnd&&<small>Thực nhận: {money(t.credited_vnd)}</small>}</td><td data-label="Trạng thái"><span class={'finance-status '+t.status}>{topupLabels[t.status]}</span></td><td data-label="Thời gian">{date(t.created_at)}</td></tr>)}</tbody></table>:<div class="finance-empty"><h3>Chưa có yêu cầu nạp</h3><p>Yêu cầu thanh toán và kết quả xử lý sẽ được lưu tại đây.</p></div>}<nav class="cms-pagination" aria-label="Phân trang yêu cầu nạp"><span>{requests.page>1&&<a href={'?page='+(requests.page-1)}>← Trang trước</a>}</span><span>{requests.total} yêu cầu</span>{requests.page*requests.page_size<requests.total&&<a href={'?page='+(requests.page+1)}>Trang sau →</a>}</nav></section>
</>}
</main><script>import '../../../scripts/finance';</script></AccountShell>
