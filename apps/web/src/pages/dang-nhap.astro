---
import AuthLayout from '../layouts/AuthLayout.astro';
import Icon from '../components/Icon.astro';
if(Astro.locals.user)return Astro.redirect(Astro.locals.user.cms_access?'/quan-tri':'/tai-khoan/ho-so');
const error=Astro.url.searchParams.get('error');
---
<AuthLayout title="Đăng nhập" heading="Đăng nhập tài khoản" intro="Tiếp tục quản lý hồ sơ và theo dõi kết quả xét duyệt của bạn.">
  {error && <p class="alert" role="alert">{error}</p>}
  <form method="post" action="/api/auth/login" class="auth-form">
    <div class="field"><label for="email">Email</label><div class="input-with-icon"><Icon name="mail" size={18}/><input id="email" name="email" type="email" autocomplete="username" required maxlength="254" placeholder="Địa chỉ email của bạn"/></div></div>
    <div class="field"><label for="password">Mật khẩu</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="128" placeholder="Nhập mật khẩu"/><button class="icon-button" type="button" data-toggle-password="password" aria-label="Hiện mật khẩu" aria-pressed="false"><Icon name="eye" size={18}/></button></div></div>
    <button class="button full" type="submit">Đăng nhập<Icon name="arrow" size={17}/></button>
  </form><p class="auth-switch"><a href="/quen-mat-khau">Quên mật khẩu?</a></p><p class="auth-switch">Chưa có tài khoản? <a href="/dang-ky">Tạo tài khoản</a></p><p class="auth-small">Bạn đang tìm chỗ ở? <a href="/tim-phong">Khám phá phòng</a> mà không cần đăng nhập.</p>
</AuthLayout>
